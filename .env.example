# Copy this file to .env and fill in your own values. Never commit a real .env file.
# This bundle deliberately ships NO real credentials -- see TECHNICAL_APPENDIX.md section 0.5.

# Required for /answer and /refine (generation + verification calls). Not required for /search
# or /health, and not required to restore the included Qdrant snapshot.
OPENAI_API_KEY=your-own-openai-api-key-here

# Optional overrides (defaults shown match what this corpus was built and evaluated with)
OPENAI_CHAT_MODEL=gpt-4o-mini
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks__bge_m3__merged
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
