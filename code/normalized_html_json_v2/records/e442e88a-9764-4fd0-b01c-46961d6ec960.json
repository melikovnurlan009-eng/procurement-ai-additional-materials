  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This note provides guidance for departments, their Executive Agencies and Non Departmental Public Bodies to help them seek assurance about the tax arrangements for their public appointees.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This note replaces Policy Procurement Note 07/12: tax arrangements of public appointees issued on 24 August 2012. This reflects the withdrawal by HM Revenue and Customs, with effect from 6 April 2015, of business entity tests referred to in the earlier note.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
