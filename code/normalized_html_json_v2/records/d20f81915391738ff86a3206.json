      "text": "discuss the contract implementation phase",
      "ordinal": 60,
      "heading_path": [
        "Communication",
        "Transitional Arrangements",
        "Post Award Supplier Meeting"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00061",
      "block_type": "li",
      "text": "agree roles and responsibilities,",
      "ordinal": 61,
      "heading_path": [
