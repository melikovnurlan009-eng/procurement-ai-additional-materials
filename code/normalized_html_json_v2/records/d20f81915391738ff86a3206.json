    },
    {
      "block_id": "b00059",
      "block_type": "p",
      "text": "The purpose of this meeting is to:",
      "ordinal": 59,
      "heading_path": [
        "Communication",
        "Transitional Arrangements",
        "Post Award Supplier Meeting"
      ],
      "source_locator": null,
      "metadata": {}
    },
