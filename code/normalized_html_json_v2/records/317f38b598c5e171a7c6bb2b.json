      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00026",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 26,
      "heading_path": [
        "Availability of procurement procedures (decision tree)",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00027",
      "block_type": "li",
      "text": "read the PPN and any supporting implementation guidance",
      "ordinal": 27,
      "heading_path": [
        "Availability of procurement procedures (decision tree)",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
