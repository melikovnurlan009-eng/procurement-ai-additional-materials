  "processed_at": "2026-08-27T02:26:31.422382+00:00",
  "title": "Price Evaluation | Procurement Journey",
  "canonical_url": "https://www.procurementjourney.scot/route-2/evaluation/price-evaluation",
  "description": null,
  "publication_date": null,
  "updated_date": null,
