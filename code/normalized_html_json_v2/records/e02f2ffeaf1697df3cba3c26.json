  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Informing candidates and tenderers",
      "ordinal": 0,
      "heading_path": [
        "Informing candidates and tenderers"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Contract award and implementation",
      "ordinal": 1,
      "heading_path": [
        "Informing candidates and tenderers"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Informing candidates and tenderers",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation requires contracting authorities to inform candidates and tenderers, as soon as possible, of decisions regarding the conclusion of framework agreements, contract awards, or admission to Dynamic Purchasing Systems.",
      "ordinal": 3,
      "heading_path": [
        "Informing candidates and tenderers",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "This regulation also requires contracting authorities to inform candidates and tenderers of decisions where a framework agreement has not been concluded, contracts not awarded, Dynamic Purchasing Systems not implemented, or recommencing procedures.",
      "ordinal": 4,
      "heading_path": [
        "Informing candidates and tenderers",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "The contracting authority may withhold certain information if its release would impede law enforcement, would be contrary to the public interest, harm the legitimate commercial interests of a supplier, or undermine fair competition.",
      "ordinal": 5,
      "heading_path": [
        "Informing candidates and tenderers",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "Unsuccessful candidates must be provided with reasons for rejection of their request to participate within 15 days of the contracting authority receiving a written request.",
      "ordinal": 6,
      "heading_path": [
        "Informing candidates and tenderers",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 7,
      "heading_path": [
        "Informing candidates and tenderers",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "Candidates and tenderers must be informed as soon as possible of the contracting authority’s decision regarding the conclusion of framework agreements, contract awards, or admission to Dynamic Purchasing Systems.",
      "ordinal": 8,
      "heading_path": [
        "Informing candidates and tenderers",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 9,
      "heading_path": [
        "Informing candidates and tenderers",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "p",
      "text": "Contracting authorities must:",
      "ordinal": 10,
      "heading_path": [
        "Informing candidates and tenderers",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "as soon as possible, inform candidates and tenderers of decisions regarding the conclusion of framework agreements, contract awards, or admission to Dynamic Purchasing Systems. This includes the grounds for any decision not to conclude a framework agreement, not to award a contract, not to implement a Dynamic Purchasing System, or to recommence the procedure.",
      "ordinal": 11,
      "heading_path": [
        "Informing candidates and tenderers",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 12,
      "heading_path": [
        "Informing candidates and tenderers",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "p",
      "text": "There is no direct equivalent section in the Procurement Act 2023",
      "ordinal": 13,
      "heading_path": [
        "Informing candidates and tenderers",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
