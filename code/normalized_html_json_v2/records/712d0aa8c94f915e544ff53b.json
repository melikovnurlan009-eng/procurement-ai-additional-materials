        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00029",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 29,
      "heading_path": [
        "Rules applicable to communication",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00030",
      "block_type": "li",
      "text": "read the regulation",
      "ordinal": 30,
      "heading_path": [
        "Rules applicable to communication",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00031",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 31,
      "heading_path": [
        "Rules applicable to communication",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
