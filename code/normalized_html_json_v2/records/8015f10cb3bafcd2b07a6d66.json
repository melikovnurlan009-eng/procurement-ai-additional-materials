    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Finalise and publish procurement pack",
      "ordinal": 1,
      "heading_path": [
        "Open procedure"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Open procedure",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation sets out the rules which apply to open procedure procurements, a type of procedure that permits any interested supplier to submit a tender in response to a call for competition. The regulation also sets out the rules regarding the minimum time limit that a contracting authority may set for the receipt of tenders under this procedure, which vary depending on the circumstances.",
      "ordinal": 3,
      "heading_path": [
        "Open procedure",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Open procedure",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "The time limit for receipt of tenders should be clearly identified in the procurement documents and must comply with the minimum periods set out in this regulation (i.e. regulation 27).",
      "ordinal": 5,
      "heading_path": [
        "Open procedure",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Open procedure",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Open procedure",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "ensure the time limit for receipt of tenders is specified in the procurement documents and complies with the minimum periods set out in this regulation, including any time period shortened as a result of the publication of a prior information notice (PIN).",
      "ordinal": 8,
      "heading_path": [
        "Open procedure",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
