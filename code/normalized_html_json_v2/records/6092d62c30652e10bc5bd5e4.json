    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "New Contract and Supplier Management (CSM) guidance is now available on the Procurement Journey , supporting Scottish public sector organisations to manage contracts effectively from mobilisation through to exit.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "The guidance provides practical advice to help improve consistency, manage risk, and deliver better outcomes and value for money.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "What’s new:",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "clear expectations for effective contract and supplier management",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "practical guidance covering key stages of the contract lifecycle, including new stations, case studies, FAQs, tools and templates",
      "ordinal": 5,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "support for managing performance, relationships, change and exit",
      "ordinal": 6,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "strong links to wider procurement policy and good practice",
      "ordinal": 7,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "new Contract and Supplier Management Guidance for non-procurement staff",
      "ordinal": 8,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "The guidance is designed to help organisations:",
      "ordinal": 9,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "embed good contract management practices from the outset",
      "ordinal": 10,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "strengthen supplier relationships and performance management",
      "ordinal": 11,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "manage change, risk and issues in a consistent and proportionate way",
      "ordinal": 12,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "support delivery of policy outcomes, including sustainability, fair work and community benefits",
      "ordinal": 13,
      "heading_path": [],
