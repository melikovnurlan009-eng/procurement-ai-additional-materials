      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Define > Assess the market",
      "ordinal": 1,
      "heading_path": [
        "Conditions relating to international agreements by which the United Kingdom is bound, other than the GPA"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Conditions relating to international agreements by which the United Kingdom is bound, other than the GPA",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "Regulation 25B provides that where a relevant international trade agreement (listed in Schedule 4A PCR 2015) applies to a particular procurement, the contracting authority undertaking that procurement must treat any works, supplies, services and suppliers (i.e. economic operators) of the signatories to that agreement no less favourably than any works, supplies, services and suppliers of the UK.",
      "ordinal": 3,
      "heading_path": [
        "Conditions relating to international agreements by which the United Kingdom is bound, other than the GPA",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Conditions relating to international agreements by which the United Kingdom is bound, other than the GPA",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Works, supplies, services and suppliers of signatories to a relevant international trade agreement must be treated no less favourably than works, suppliers, services and suppliers of the UK.",
      "ordinal": 5,
      "heading_path": [
        "Conditions relating to international agreements by which the United Kingdom is bound, other than the GPA",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Conditions relating to international agreements by which the United Kingdom is bound, other than the GPA",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities must:",
      "ordinal": 7,
      "heading_path": [
        "Conditions relating to international agreements by which the United Kingdom is bound, other than the GPA",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "ensure at all stages of a procurement, it treats works, supplies, services and suppliers of signatories to a relevant international trade agreement no less favourably than works, suppliers, services and suppliers of the UK.",
      "ordinal": 8,
      "heading_path": [
        "Conditions relating to international agreements by which the United Kingdom is bound, other than the GPA",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
