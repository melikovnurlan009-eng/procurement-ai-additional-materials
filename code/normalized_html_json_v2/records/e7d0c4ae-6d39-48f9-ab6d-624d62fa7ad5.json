  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) is now out of date. Please refer to PPN 10/21: Thresholds & Inclusion of VAT",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This Procurement Policy Note sets out the new threshold levels to apply for the purposes of the Public Contracts Regulations . They come into force on 1 January 2016.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "This note applies to all contracting authorities, as defined by the Regulations. This will include all central government departments, their executive agencies, non-departmental public bodies and the wider public sector.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This note also contains information relevant to utilities as defined by the Utilities Contracts Regulations .",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
