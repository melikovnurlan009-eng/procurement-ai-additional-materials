    },
    {
      "block_id": "b00002",
      "block_type": "li",
      "text": "The Procurement Act 2023 - Text of the Procurement Act 2023.",
      "ordinal": 2,
      "heading_path": [
        "Useful links",
        "Procurement legislation and Guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "li",
      "text": "The Procurement Regulations 2024 - These regulations contain much of the detailed rules that underpin the Procurement Act 2023.",
      "ordinal": 3,
      "heading_path": [
        "Useful links",
        "Procurement legislation and Guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "The Procurement Act 2023 (Commencement No. 3 and Transitional and Saving Provisions) Regulations 2024 (as amended) - These regulations (as amended to reflect the delayed implementation date of 24 February 2025) set out which provisions of the Procurement Act 2023 will come into force on that date (i.e. the majority of the Act) and which will be further delayed (particularly, obligations to publish Payments Compliance Notices, Contract Payments Notices and Contract Performance Notices).",
      "ordinal": 4,
      "heading_path": [
        "Useful links",
        "Procurement legislation and Guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "Transforming Public Procurement - The government's TPP page for information on procurement law reform.",
      "ordinal": 5,
      "heading_path": [
        "Useful links",
        "Procurement legislation and Guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "Government Guidance on the Procurement Act 2023 - Official government guidance, divided into Plan, Define, Procure and Manage phases.",
      "ordinal": 6,
      "heading_path": [
        "Useful links",
        "Procurement legislation and Guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "The Procurement Pathway - The government's procurement planning tool, contain resources, templates and guidance for each of the plan, define, procure and manage \"phases\".",
      "ordinal": 7,
      "heading_path": [
        "Useful links",
        "Procurement legislation and Guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "Government Commercial College - Home of the government's 10-module training course on the Procurement Act 2023 and the Procurement Act 2023 Communities of Practice forums. Available to public bodies and their advisors.",
      "ordinal": 8,
      "heading_path": [
        "Useful links",
        "Procurement legislation and Guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "Government TPP Knowledge Drops - Introductory training modules aimed at public bodies and suppliers.",
      "ordinal": 9,
      "heading_path": [
        "Useful links",
        "Procurement legislation and Guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "heading",
      "text": "Procurement organisations",
      "ordinal": 10,
      "heading_path": [
        "Useful links",
        "Procurement organisations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "Procurement Lawyers' Association - UK based association which discusses the law underpinning procurement, prepares papers on current issues and provides input to government consultations.",
      "ordinal": 11,
      "heading_path": [
        "Useful links",
        "Procurement organisations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "Chartered Institute of Purchasing and Supply - Promotes good procurement practice and offers training courses.",
      "ordinal": 12,
      "heading_path": [
        "Useful links",
        "Procurement organisations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "NHS Supply Chain - Provides procurement and supply chain services to NHS bodies.",
      "ordinal": 13,
      "heading_path": [
        "Useful links",
        "Procurement organisations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "heading",
      "text": "Insightful blogs from our experts",
      "ordinal": 14,
      "heading_path": [
        "Useful links",
        "Procurement organisations",
        "Insightful blogs from our experts"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "p",
      "text": "We bring you updates and commentary on the latest procurement law news affecting anyone who deals with public procurement as part of their role.",
      "ordinal": 15,
      "heading_path": [
        "Useful links",
        "Procurement organisations",
        "Insightful blogs from our experts"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "heading",
      "text": "Watch more webinars on-demand",
      "ordinal": 16,
      "heading_path": [
        "Useful links",
        "Procurement organisations",
        "Watch more webinars on-demand"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "p",
      "text": "View our collection of webinars where our procurement experts address public procurement in the UK, focussing on topics that those working with public procurement need to consider.",
      "ordinal": 17,
      "heading_path": [
        "Useful links",
        "Procurement organisations",
