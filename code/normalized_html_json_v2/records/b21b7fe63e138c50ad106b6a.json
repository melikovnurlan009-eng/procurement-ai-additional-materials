      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "p",
      "text": "There is no direct equivalent section in the Procurement Act 2023",
      "ordinal": 12,
      "heading_path": [
        "Invitations to candidates",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
