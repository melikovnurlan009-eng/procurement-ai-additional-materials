  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Assessing suitability etc",
      "ordinal": 0,
      "heading_path": [
        "Assessing suitability etc"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Plan > Strategy and plan",
      "ordinal": 1,
      "heading_path": [
        "Assessing suitability etc"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Assessing suitability etc",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that, other than in specific circumstances, a contracting authority must not include a pre-qualification stage in a below-threshold procurement.",
      "ordinal": 3,
      "heading_path": [
        "Assessing suitability etc",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "The specific circumstances include where the subject matter of a below-threshold procurement opportunity constitutes:",
      "ordinal": 4,
      "heading_path": [
        "Assessing suitability etc",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "a public works contract or a public services contract (for social and other specific services listed in schedule 3 PCR 2015) procured by a central government authority, where the value of the contract is over the value set out in regulation 5(1)(b) (threshold amounts), or",
      "ordinal": 5,
      "heading_path": [
        "Assessing suitability etc",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "a public works contract or a public services contract (for social and other specific services listed in schedule 3 PCR 2015) procured by a sub-central contracting authority, where the value of the contract is over the value set out in regulation 5(1)(c) (threshold amounts).",
      "ordinal": 6,
      "heading_path": [
        "Assessing suitability etc",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Regulation 111 does permit contracting authorities to ask suppliers questions aimed at assessing suitability for the contract, however only where the questions are relevant and proportionate to the subject matter of the procurement.",
      "ordinal": 7,
      "heading_path": [
        "Assessing suitability etc",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 8,
      "heading_path": [
        "Assessing suitability etc",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "When designing a below-threshold procurement process, consideration should be given as to whether a pre-qualification stage will be permitted in accordance with this regulation (i.e. regulation 111).",
      "ordinal": 9,
      "heading_path": [
        "Assessing suitability etc",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 10,
      "heading_path": [
        "Assessing suitability etc",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 11,
      "heading_path": [
        "Assessing suitability etc",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "consider whether a pre-qualification stage will be permitted in accordance with this regulation (i.e. regulation 111)",
      "ordinal": 12,
      "heading_path": [
        "Assessing suitability etc",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "ensure that any questions asked of suppliers, insofar as they are aimed at assessing suitability, are relevant and proportionate to the subject matter of the procurement",
      "ordinal": 13,
      "heading_path": [
        "Assessing suitability etc",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "li",
      "text": "consider any guidance issued by the Minister for the Cabinet Office in relation to this regulation.",
      "ordinal": 14,
      "heading_path": [
        "Assessing suitability etc",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 15,
      "heading_path": [
        "Assessing suitability etc",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 16,
      "heading_path": [
        "Assessing suitability etc",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "li",
      "text": "Section 85: Regulated below-threshold contracts: procedure",
      "ordinal": 17,
      "heading_path": [
        "Assessing suitability etc",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "li",
      "text": "Section 86: Regulated below-threshold contracts: duty to consider small and medium-sized enterprises",
      "ordinal": 18,
      "heading_path": [
