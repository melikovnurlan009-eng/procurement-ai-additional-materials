      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 19,
      "heading_path": [
        "Reserved contracts for certain services",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00020",
      "block_type": "li",
      "text": "read the regulation",
      "ordinal": 20,
      "heading_path": [
        "Reserved contracts for certain services",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00021",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 21,
      "heading_path": [
        "Reserved contracts for certain services",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
