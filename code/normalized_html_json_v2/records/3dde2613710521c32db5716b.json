      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "li",
      "text": "Schedule 2: Exempted contracts, Part 2: Subject-matter exempted contracts, Paragraph 22: Research and development services",
      "ordinal": 14,
