  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Publication of notices",
      "ordinal": 0,
      "heading_path": [
        "Publication of notices"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Contract award and implementation",
      "ordinal": 1,
      "heading_path": [
        "Publication of notices"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Publication of notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation sets out the circumstances in which contracting authorities are required to publish a contract notice and a contract award notice in relation to public contracts awarded for the services referred to in regulation 74 (award of contract for social and other specific services) PCR 2015. The notices must be published on the Find a Tender service in accordance with the requirements of regulation 51 (publication on the UK e-notification service) PCR 2015.",
      "ordinal": 3,
      "heading_path": [
        "Publication of notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Publication of notices",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "A contract award notice should be published following the award of a public contract for services covered by regulation 74. Contract award notices may be grouped together and published on a quarterly basis (within 30 days of the end of each quarter).",
      "ordinal": 5,
      "heading_path": [
        "Publication of notices",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Publication of notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Publication of notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "ensure that a contract award notice is published in accordance with this regulation (i.e. regulation 75), where the subject matter of the public contract awarded is covered by regulation 74",
      "ordinal": 8,
      "heading_path": [
        "Publication of notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "consider whether contract award notices should be grouped together and published on a quarterly basis. Where this option is selected, contracting authorities should ensure that the grouped notices are published within 30 days of the end of each quarter",
      "ordinal": 9,
      "heading_path": [
        "Publication of notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "ensure that the contract award notice is published in accordance with regulation 51.",
      "ordinal": 10,
      "heading_path": [
        "Publication of notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
