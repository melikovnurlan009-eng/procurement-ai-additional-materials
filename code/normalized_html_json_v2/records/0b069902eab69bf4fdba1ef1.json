  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Pipeline Practicalities ...",
      "ordinal": 0,
      "heading_path": [
        "Pipeline Practicalities ..."
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "By 26th May 2025, authorities with an anticipated spend on works, services and goods contracts of over £100 million per annum need to publish their first UK01 Pipeline Notices under the Act.",
      "ordinal": 1,
      "heading_path": [
        "Pipeline Practicalities ..."
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "These are notices of each contract valued at over £2m inclusive of VAT that the authority expects to enter into over the next 18 months.",
      "ordinal": 2,
      "heading_path": [
        "Pipeline Practicalities ..."
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "Government Commercial Function has published this leaflet as guidance on how to comply with the obligation.",
      "ordinal": 3,
      "heading_path": [
        "Pipeline Practicalities ..."
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "At present it appears that a separate UK01 Pipeline Notice needs to be published for each individual contract. It looks like Find a Tender service will eventually have an option to display all contracts in a pipeline for a particular authority or geographical area, although this will not be available immediately.",
      "ordinal": 4,
      "heading_path": [
        "Pipeline Practicalities ..."
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "heading",
      "text": "Our content explained",
      "ordinal": 5,
      "heading_path": [
        "Pipeline Practicalities ...",
        "Our content explained"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "Every piece of content we create is correct on the date it’s published but please don’t rely on it as legal advice. If you’d like to speak to us about your own legal requirements, please contact one of our expert lawyers.",
      "ordinal": 6,
      "heading_path": [
        "Pipeline Practicalities ...",
        "Our content explained"
      ],
      "source_locator": null,
      "metadata": {}
    },
