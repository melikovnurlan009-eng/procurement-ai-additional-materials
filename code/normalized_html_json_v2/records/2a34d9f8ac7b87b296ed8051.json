    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Finalise and publish procurement pack",
      "ordinal": 1,
      "heading_path": [
        "Contract notices"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Contract notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation sets out the information that contracting authorities are required to include in contract notices and confirms that contract notices must be published in accordance with the requirements of regulation 51 PCR 2015 (publication on the UK e-notification service).",
      "ordinal": 3,
      "heading_path": [
        "Contract notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Contract notices",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Contract notices must be published on the UK e-notification service (i.e. the \"Find a Tender\" service) and must include all relevant information required by this regulation (i.e. regulation 49).",
      "ordinal": 5,
      "heading_path": [
        "Contract notices",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Contract notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Contract notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "ensure that all the information set out in part C of Annex 5 to the Public Contracts Directive, as amended by this regulation (i.e. regulation 49(a)), is included in a contract notice before it is published on Find a Tender",
      "ordinal": 8,
      "heading_path": [
        "Contract notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "ensure that the contract notice is published in accordance with regulation 51 PCR 2015 (publication on the UK e-notification service).",
      "ordinal": 9,
      "heading_path": [
        "Contract notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 10,
      "heading_path": [
        "Contract notices",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 11,
      "heading_path": [
        "Contract notices",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "Section 21: Tender notices and associated tender documents",
      "ordinal": 12,
