  "title": "Procurement Policy Note 11/20: Reserving below threshold procurements",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-1120-reserving-below-threshold-procurements",
  "description": "This procurement policy note set out the options that may be considered by Contracting Authorities when procuring contracts for goods, services and works with a value below the applicable thresholds.",
  "publication_date": "2020-12-15T12:39:00+00:00",
