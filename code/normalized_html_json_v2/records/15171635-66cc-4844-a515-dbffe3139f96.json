  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note ( PPN ) reminds in-scope organisations of the requirements to publish procurement information on Contracts Finder.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "The PPN and associated guidance replaces PPN 07/21 and clarifies requirements on NHS Foundation Trusts.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "There is no change to the publication requirements for other contracting authorities that were set out in PPN 07/21.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
