    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Clarification and due diligence",
      "ordinal": 1,
      "heading_path": [
        "Decisions of the jury"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Decisions of the jury",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that the design contest jury must make decisions independently. The jury must evaluate the candidates’ plans and projects anonymously and solely according to the criteria specified in the contest notice. The jury must prepare a report ranking the projects based on their merits, including any remarks and any points needing clarification. Anonymity must be maintained until the jury has reached a decision. Candidates may be asked to clarify their projects in response to questions from the jury. Any dialogue between the jury and candidates must be documented.",
      "ordinal": 3,
      "heading_path": [
        "Decisions of the jury",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Decisions of the jury",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "The design contest jury may ask candidates to clarify their projects.",
      "ordinal": 5,
      "heading_path": [
        "Decisions of the jury",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Decisions of the jury",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Decisions of the jury",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "ensure that jury members understand that they may seek clarification from candidates in relation to their projects",
      "ordinal": 8,
      "heading_path": [
        "Decisions of the jury",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "ensure that the report ranking the projects, as prepared by the jury members, includes any points for clarification ensure that any dialogue between the jury and candidates is documented.",
      "ordinal": 9,
      "heading_path": [
        "Decisions of the jury",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
