      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 12,
      "heading_path": [
        "Occasional joint procurement",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
