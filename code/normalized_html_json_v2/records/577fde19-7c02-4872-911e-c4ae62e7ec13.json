  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "The Carbon Reduction Schedule provides standard T&Cs to support contract specific decarbonisation objectives to be set and delivered, and provides a framework to monitor and assess the Supplier’s decarbonisation performance. These include contract specific GHG emissions reporting, setting supplier GHG emissions reduction targets and monitoring and reducing GHG emissions throughout the life of the contract though a supplier GHG emissions Reduction Plan.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
