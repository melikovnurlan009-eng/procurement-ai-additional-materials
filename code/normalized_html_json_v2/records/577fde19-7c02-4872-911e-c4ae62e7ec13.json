  "title": "PPN 01/24 Carbon Reduction Contract Schedule",
  "canonical_url": "https://www.gov.uk/government/publications/ppn-0124-carbon-reduction-contract-schedule",
  "description": "PPN 01/24 introduces an optional standard carbon reduction contract schedule that can be included in Government contracts.",
  "publication_date": "2024-03-18T00:00:00+00:00",
  "updated_date": "2024-03-18T00:00:00+00:00",
