  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) is now out of date.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "Procurement Policy Note 04/20: Recovery and Transition from COVID-19 sets out information and guidance for public bodies on payment of their suppliers to ensure service continuity during the current coronavirus, COVID-19, outbreak. It updates and builds on the provisions contained in PPN 02/20.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "When applying this Procurement Policy Note:",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "• state funded schools should refer to PPN 02/20 and 04/20: guidance for state funded schools",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "• post-16 educational establishments in higher education (HE) and further education (FE) should refer to PPN 02/20 and 04/20: post-16 educational sector guidance",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
