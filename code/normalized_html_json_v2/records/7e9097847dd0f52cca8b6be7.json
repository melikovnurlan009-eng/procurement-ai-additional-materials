      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 15,
      "heading_path": [
        "Open procedure",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
