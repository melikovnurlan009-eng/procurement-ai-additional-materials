      "ordinal": 0,
      "heading_path": [
        "Standstill period"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Contract award and implementation",
      "ordinal": 1,
      "heading_path": [
        "Standstill period"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Standstill period",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation requires a contracting authority to observe a standstill period before entering into a contract or concluding a framework agreement. The length of the standstill period varies depending on how the relevant notices are sent to suppliers. If notices are sent by fax or electronic means, the standstill period ends at midnight on the tenth day after the last notice is sent to a candidate or tenderer, eligible to receive a notice. If the notice is sent by other means, the standstill period may be as long as 15 days.",
      "ordinal": 3,
      "heading_path": [
        "Standstill period",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Standstill period",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Contracting authorities cannot enter into a public contract before the standstill period has elapsed. Depending on how the relevant notices are sent, the standstill period will elapse either at the end of the tenth day after the last notice is sent (if notices are sent by fax or electronic means) or at the end of the fifteenth day after the date on which the last notice is sent.",
      "ordinal": 5,
      "heading_path": [
        "Standstill period",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Standstill period",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Standstill period",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "observe, in full, the relevant standstill period before taking steps to enter into the contract or conclude the framework agreement",
      "ordinal": 8,
      "heading_path": [
        "Standstill period",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "ensure the correct length of standstill period is observed, depending on whether the notices are sent electronically or by other means.",
      "ordinal": 9,
      "heading_path": [
        "Standstill period",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
