    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Manage > Manage and monitor",
      "ordinal": 1,
      "heading_path": [
        "Publication of payment performance statistics"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Publication of payment performance statistics",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This PPN applies to all central government departments including their executive agencies and non-departmental public bodies, and wider public sector bodies including local authorities and NHS bodies (collectively referred to as 'in-scope organisations'). This PPN does not apply to procurement of health care services for the purposes of the NHS within the meaning and scope of the National Health Service (Procurement, Patient Choice and Competition (No.2)) Regulations 2013, and maintained schools and academies.",
      "ordinal": 3,
      "heading_path": [
        "Publication of payment performance statistics",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "The PPN provides that in-scope organisations are required to publish data demonstrating compliance with the obligation to pay undisputed invoices within 30 days to first tier suppliers / prime contractors over the previous 12 months. The data should be published annually, at the end of each financial year, and freely available via the internet.",
      "ordinal": 4,
      "heading_path": [
        "Publication of payment performance statistics",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 5,
      "heading_path": [
        "Publication of payment performance statistics",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "Data must be published by in-scope organisations which demonstrates compliance with the obligation to pay undisputed invoices within 30 days to first tier suppliers / prime contractors over the previous 12 months. The data should be freely available via the internet.",
      "ordinal": 6,
      "heading_path": [
        "Publication of payment performance statistics",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 7,
      "heading_path": [
        "Publication of payment performance statistics",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "In-scope organisations should:",
      "ordinal": 8,
      "heading_path": [
        "Publication of payment performance statistics",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "publish data annually to demonstrate they have complied with the obligation to pay invoices within 30 days to first tier suppliers / prime contractors over the previous 12 months",
      "ordinal": 9,
      "heading_path": [
        "Publication of payment performance statistics",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "ensure the published data is freely available via the internet and maintained until replaced by a more recent set of statistics.",
      "ordinal": 10,
      "heading_path": [
        "Publication of payment performance statistics",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 11,
      "heading_path": [
        "Publication of payment performance statistics",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "p",
      "text": "The PPN should be read alongside the relevant parts of the legal framework, including but not limited to, the following provisions of the Public Contracts Regulations 2015 (which may be particularly relevant to the consideration of this PPN):",
      "ordinal": 12,
      "heading_path": [
        "Publication of payment performance statistics",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "Regulation 18: Principles of procurement",
      "ordinal": 13,
      "heading_path": [
        "Publication of payment performance statistics",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "li",
      "text": "Regulation 113: Payment of undisputed invoices within 30 days by contracting authorities, contractors and subcontractors",
      "ordinal": 14,
