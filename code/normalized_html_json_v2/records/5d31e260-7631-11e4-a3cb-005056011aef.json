  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) is now out of date",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This procurement policy information note outlines a number of amendments to the public procurement regulations that will come into effect from October 2011. It covers the following:",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "li",
      "text": "changes to the time limits for Court challenges to procurement decisions, following the European Court of Justice’s “Uniplex” ruling, and some related procedural changes",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "li",
      "text": "modifications to the criteria for the ‘automatic suspension’",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "amendments to the definitions of certain offences and other causes for which economic operators may, or must, be rejected",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "Machinery of Government changes affecting the Office of Government Commerce (OGC)",
      "ordinal": 5,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "a few miscellaneous minor updates, improvements and corrections",
      "ordinal": 6,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00007",
