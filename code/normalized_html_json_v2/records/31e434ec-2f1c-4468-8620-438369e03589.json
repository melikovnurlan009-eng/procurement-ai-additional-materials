  "title": "Procurement Policy Note 03/21: The Sourcing and Consultancy Playbooks",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0321-the-sourcing-and-consultancy-playbooks",
  "description": "This Procurement Policy Note sets out guidance on the updated Sourcing Playbook, the new Consultancy Playbook, and associated guidance notes.",
  "publication_date": "2021-05-20T11:30:07+01:00",
  "updated_date": "2021-05-20T11:30:07+01:00",
