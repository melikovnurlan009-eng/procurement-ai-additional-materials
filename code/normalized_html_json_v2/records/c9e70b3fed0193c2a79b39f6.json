      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Finalise and publish procurement pack",
      "ordinal": 1,
      "heading_path": [
        "Notices"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "Contracting authorities planning to conduct a design contest must announce their intention through a contest notice. The contest notice must be submitted for publication to the UK e-notification service, in accordance with regulation 51 (publication on the UK e-notification service) PCR 2015.",
      "ordinal": 3,
      "heading_path": [
        "Notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "After the design contest has taken place, the contracting authorities must submit a notice of the contest results for publication to Finder a Tender, in accordance with regulation 51. The contracting authorities must be able to demonstrate the date on which the notice was submitted to the UK e-notification service.",
      "ordinal": 4,
      "heading_path": [
        "Notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "In cases where releasing information on the contest outcome could impede law enforcement, be contrary to the public interest, harm the commercial interests of a particular enterprise, or impact fair competition between service providers, such information may be withheld from publication.",
      "ordinal": 5,
      "heading_path": [
        "Notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Notices",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities must publish their intention to conduct a design contest through a contest notice, submitted to Find a Tender",
      "ordinal": 7,
      "heading_path": [
        "Notices",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 8,
      "heading_path": [
        "Notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 9,
      "heading_path": [
        "Notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "ensure that their intention to conduct a design contest is published via a contest notice",
      "ordinal": 10,
      "heading_path": [
        "Notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "ensure that a contest notice is sent to Find a Tender for publication.",
      "ordinal": 11,
      "heading_path": [
