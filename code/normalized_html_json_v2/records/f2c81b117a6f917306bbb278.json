      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "Organisations are allowed to shorten certain deadlines in case of urgency.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "Urgency needs to be suitably justified. This does not need to be an extreme urgency brought about by unforeseeable events and not your Organisation’s fault. The contract notice must provide a justification.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "li",
      "text": "Bidders must be allowed at least 15 days from the day on which the Contract Notice was sent to submit the selection stage information.",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "After the ITT is issued, bidders must be allowed a minimum of 10 days to submit initial tenders.",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "From this point the same rules apply as in the case of the previous variations of this procedure.",
      "ordinal": 5,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    }
  ],
