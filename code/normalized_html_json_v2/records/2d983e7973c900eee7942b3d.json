        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00033",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 33,
      "heading_path": [
        "Procurement in an emergency",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00034",
      "block_type": "li",
      "text": "read the PPN and any supporting implementation guidance",
      "ordinal": 34,
      "heading_path": [
        "Procurement in an emergency",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00035",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 35,
      "heading_path": [
        "Procurement in an emergency",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
