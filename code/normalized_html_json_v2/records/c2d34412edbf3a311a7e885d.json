      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 13,
      "heading_path": [
        "Scope of Chapter 7",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
