    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Finalise and publish procurement pack",
      "ordinal": 1,
      "heading_path": [
        "Scope of Chapter 7"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Scope of Chapter 7",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation states that Chapter 7 PCR 2015 applies to procurements within the scope of Part 2 PCR, but that regulations 106 (publication of information on Contracts Finder where contract notices are used) and 108 PCR (publication of information on Contracts Finder about contracts awarded) do not apply where the contracting authority is a maintained school, an Academy or a sixth form college corporation.",
      "ordinal": 3,
      "heading_path": [
        "Scope of Chapter 7",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Scope of Chapter 7",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Chapter 7 PCR applies to procurements within the scope of Part 2 PCR.",
      "ordinal": 5,
      "heading_path": [
        "Scope of Chapter 7",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Scope of Chapter 7",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Scope of Chapter 7",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "ensure that they consider the requirements of Chapter 7 PCR for procurements within the scope of Part 2 PCR",
      "ordinal": 8,
      "heading_path": [
        "Scope of Chapter 7",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "remain mindful that regulations 106 and 108 PCR do not apply to maintained schools, Academies and sixth form college corporations.",
      "ordinal": 9,
      "heading_path": [
        "Scope of Chapter 7",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 10,
      "heading_path": [
        "Scope of Chapter 7",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "p",
      "text": "There is no direct equivalent section in the Procurement Act 2023.",
      "ordinal": 11,
      "heading_path": [
        "Scope of Chapter 7",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
