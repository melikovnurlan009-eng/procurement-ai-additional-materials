      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 13,
      "heading_path": [
        "Termination of contracts",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
