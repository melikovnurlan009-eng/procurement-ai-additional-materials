    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Selection stage",
      "ordinal": 1,
      "heading_path": [
        "Selection criteria"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation sets out rules which the contracting authority may use to impose minimum requirements on candidates to participate in a procurement procedure. The regulation also provides further rules relating to the permitted categories of selection criteria, namely they may only relate to:",
      "ordinal": 3,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "(a) suitability to pursue a professional activity",
      "ordinal": 4,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "(b) economic and financial standing, and",
      "ordinal": 5,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "(c) technical and professional ability.",
      "ordinal": 6,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 7,
      "heading_path": [
        "Selection criteria",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "The contracting authority must shortlist suitable candidates to participate in the procurement based on the selection criteria set out in the procurement documents.",
      "ordinal": 8,
      "heading_path": [
        "Selection criteria",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 9,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 10,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "apply the selection criteria set out in the procurement documents when shortlisting candidates to participate in the procurement",
      "ordinal": 11,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "ensure that all selection criteria comply with the relevant conditions set out in this regulation (i.e. regulation 58).",
      "ordinal": 12,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 13,
      "heading_path": [
        "Selection criteria",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 14,
      "heading_path": [
        "Selection criteria",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "li",
      "text": "Section 22: Conditions of Participation",
      "ordinal": 15,
      "heading_path": [
        "Selection criteria",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
