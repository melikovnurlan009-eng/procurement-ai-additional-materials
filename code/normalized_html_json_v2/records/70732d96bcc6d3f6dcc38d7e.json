        "Complying with international obligations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Finalise and publish procurement pack",
      "ordinal": 1,
      "heading_path": [
        "Complying with international obligations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Complying with international obligations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "The PPN is applicable to all contracting authorities, including central government, executive agencies, non-departmental public bodies, wider public sector, local authorities and NHS bodies.",
      "ordinal": 3,
      "heading_path": [
        "Complying with international obligations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "Contracting authorities are reminded in this PPN that public procurement should not be used as a tool to boycott tenders from suppliers based in other countries, except where formal legal sanctions, embargoes and restrictions have been put in place by the UK Government. In particular, the PPN reminds contracting authorities that the UK has obligations under the Agreement on Government Procurement (GPA) to treat suppliers from GPA signatory countries equally.",
      "ordinal": 4,
      "heading_path": [
        "Complying with international obligations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 5,
      "heading_path": [
        "Complying with international obligations",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "Procurement decisions should not be used as a tool to boycott tenders from suppliers based in other countries except where formal legal sanctions, embargoes and restrictions have been put in place by the UK Government.",
      "ordinal": 6,
      "heading_path": [
        "Complying with international obligations",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 7,
      "heading_path": [
        "Complying with international obligations",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 8,
      "heading_path": [
        "Complying with international obligations",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "ensure that the procurement strategy and documents are not used as a means of boycotting tenders from suppliers based in other countries where formal legal sanctions do not apply",
      "ordinal": 9,
      "heading_path": [
        "Complying with international obligations",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "ensure that suppliers from GPA signatory countries are treated equally and without discrimination.",
      "ordinal": 10,
      "heading_path": [
        "Complying with international obligations",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 11,
      "heading_path": [
        "Complying with international obligations",
