  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note sets out new measures to increase the visibility of subcontracting opportunities in Government supply chains and to provide greater visibility of supply chain spend. The measures include a reporting template, which is also attached.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This note applies to all Central Government Departments, their Executive Agencies and Non Departmental Public Bodies. In-Scope Organisations must apply the provisions of this Procurement Policy Note in new procurements commencing from 1 May 2018.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
