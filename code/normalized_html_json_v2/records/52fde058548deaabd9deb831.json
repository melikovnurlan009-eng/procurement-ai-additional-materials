      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 16,
      "heading_path": [
        "Prior information notices",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
