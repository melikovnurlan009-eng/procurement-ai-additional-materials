      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "consider encouraging suppliers to sign the Armed Forces Covenant, by including the text at Annex A of this PPN (i.e. PPN 06/16) in invitation to tender documents.",
      "ordinal": 9,
