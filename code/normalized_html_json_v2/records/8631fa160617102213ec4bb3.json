      "text": "Conflicts of interest",
      "ordinal": 0,
      "heading_path": [
        "Conflicts of interest"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Define > Assess the market",
      "ordinal": 1,
