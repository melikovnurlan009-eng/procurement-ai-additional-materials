  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "New Year, New Procurement Thresholds",
      "ordinal": 0,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "New Procurement Thresholds from 1 January 2026",
      "ordinal": 1,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "From 1 January 2026, the procurement thresholds under the Procurement Act 2023, will be revised. The changes are implemented through the Procurement Act 2023 (Threshold Amounts) (Amendment) Regulations 2025 , which amend Schedule 1 of the Act. The new thresholds apply to all new procurements commenced on or after 1 January 2026 but do not apply affect procurements already in train before that date.",
      "ordinal": 2,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "Why are the Thresholds Changing?",
      "ordinal": 3,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "PPN 023 reminds us that the thresholds at which public procurement opportunities become subject to the full regime are updated every two years to reflect currency fluctuations and ensure the UK complies with its obligations under the World Trade Organisation’s Agreement on Government Procurement (GPA). In addition, the threshold amounts for regulated below-threshold contracts and defence and security contracts are being amended to ensure consistency and alignment with the GPA.",
      "ordinal": 4,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "For procurements starting on or after 1 January 2026 , the thresholds (inclusive of VAT) set out in the table below will apply.",
      "ordinal": 5,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "Practical takeaways",
      "ordinal": 6,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "Review upcoming procurements scheduled for early 2026. If the estimated contract value exceeds the new thresholds, you must follow the full procurement regime under the Procurement Act",
      "ordinal": 7,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "Ensure your procurement policies, templates, and training materials are updated to reflect the revised figures.",
      "ordinal": 8,
      "heading_path": [
        "New Year, New Procurement Thresholds"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "table",
      "text": "\tType of Contract\tThreshold Amount\n1\tDefence and security contract that is a works contract\t£5,193,000\n2\tDefence and security contract that is a concession contract\t£5,193,000\n3\tDefence and security contract not within row 1, 2 or 8\t£415,440\n4\tUtilities contract that is a works contract\t£5,193,000\n5\tUtilities contract that is a light touch contract\t£884,720\n6\tUtilities contract not within row 3, 4 or 5\t£415,440\n7\tLight touch contract that is a concession contract\t£5,372,609\n8\tLight touch contract not within row 5 or 7\t£663,540\n9\tConcession contract not within row 2, 6 or 7\t£5,193,000\n10\tWorks contract not within row 1, 4 or 9\t£5,193,000\n11\tContract for goods, services or works to a central government authority not within any other row\t£135,018\n12\tContract for goods, services or works to a sub-central government authority not within any other row\t£207,720",
