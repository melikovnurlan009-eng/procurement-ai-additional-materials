  "logical_structure": [],
  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "CONSULTATION OF UK STEEL’S DIGITAL CATALOGUE [include this requirement in the main body of the contract for new relevant steel procurements]",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "1.1. Where in performance of the Contract the Supplier is required to procure steel products, the Supplier shall first consult UK Steel’s Digital Catalogue.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "1.2. Where the Supplier is procuring steel products indirectly, it shall ensure that its Sub-Contractor(s) comply with Clause 1.1.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
