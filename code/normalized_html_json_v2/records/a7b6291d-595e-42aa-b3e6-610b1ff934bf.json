    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "New reporting requirements on prompt payment were announced in the Budget 2015 .",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This note sets out what central government departments, including their Executive Agencies and Non Departmental Public Bodies, must do to comply with the requirements. It also restates the policy on prompt payment for central government (Policy Procurement Note 08/10).",
