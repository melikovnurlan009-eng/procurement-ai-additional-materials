    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that Part 2 PCR 2015 does not apply to contracts or framework agreements that are covered by the Health Care Services (Provider Selection Regime) Regulations 2023.",
      "ordinal": 3,
      "heading_path": [
        "Contracts and framework agreements for health and care services",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Contracts and framework agreements for health and care services",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Part 2 PCR will not apply to any contracts or framework agreements referred to in this regulation (i.e. regulation 12A).",
      "ordinal": 5,
      "heading_path": [
        "Contracts and framework agreements for health and care services",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
