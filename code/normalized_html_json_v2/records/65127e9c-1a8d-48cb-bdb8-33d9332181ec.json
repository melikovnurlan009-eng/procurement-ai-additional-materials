  "logical_structure": [],
  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "Since 2011 there has been a policy about the choice of procurement routes (e.g. Open or Restricted procedures) and the rationale supporting it. This was supported by a Procurement Route Decision Tree, as part of the Lean sourcing process.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "With the introduction of the Public Contracts Regulations 2015 there are new choices available and the policy, together with the Decision Tree, has been updated to take account of these.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "This note contains a new Decision Tree and guidance on the choice of procurement procedure. It also sets out the general policy expectations on procurement which continue to apply.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
