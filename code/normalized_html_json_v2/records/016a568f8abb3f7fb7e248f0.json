      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 17,
      "heading_path": [
        "New thresholds",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "li",
      "text": "read the PPN and any supporting implementation guidance",
      "ordinal": 18,
      "heading_path": [
        "New thresholds",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 19,
