  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This note has been replaced by procurement policy note 06/13: promoting tax compliance .",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "A new policy was announced in the March 2013 Budget on the use of the procurement process to promote tax compliance. The new policy will apply to central government contracts over £5million that are advertised on or after 1 April 2013. Suppliers bidding for government contracts will be required to self-certify their tax compliance.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "This procurement policy note sets out the scope and background of the new policy and advises on how to take account of it in procurement documentation.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
