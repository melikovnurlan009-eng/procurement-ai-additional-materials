    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "Where you have not built an electronic catalogue as part of the tender process and the commodity/service is deemed to be made into a catalogue, you should set up the successful tenderer on the Pecos Content Management System (PCM) to ensure that you can prepare the catalogues.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "PCM is not appropriate for Care and Support Services .",
      "ordinal": 2,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services ."
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "The process of content management from start to finish can take weeks, mainly dependent on the size (number of line items) and the number of catalogues involved.",
      "ordinal": 3,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services ."
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
