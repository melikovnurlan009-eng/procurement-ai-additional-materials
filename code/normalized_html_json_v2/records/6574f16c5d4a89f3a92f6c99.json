      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "heading",
      "text": "Content Management Stages",
      "ordinal": 5,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services .",
        "Content Management Stages"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "You will need to:",
      "ordinal": 6,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services .",
        "Content Management Stages"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "Receive the initial catalogue data from suppliers;",
      "ordinal": 7,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services .",
        "Content Management Stages"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "Check catalogue content;",
      "ordinal": 8,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services .",
        "Content Management Stages"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "undertake validation checks;",
      "ordinal": 9,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services .",
        "Content Management Stages"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "Test.",
      "ordinal": 10,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services .",
        "Content Management Stages"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "p",
      "text": "The above should be done before finally issuing to the end user organisations.",
      "ordinal": 11,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services .",
        "Content Management Stages"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "p",
      "text": "It is essential to allow enough time in your process for these tasks to be completed prior to the date that the contract or framework is required to be active.",
      "ordinal": 12,
      "heading_path": [
        "PCM is not appropriate for Care and Support Services .",
