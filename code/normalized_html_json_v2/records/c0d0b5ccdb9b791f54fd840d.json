  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Useful links",
      "ordinal": 0,
      "heading_path": [
        "Useful links"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "heading",
      "text": "Procurement legislation",
      "ordinal": 1,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "li",
      "text": "Public Contracts Regulations 2015 These Regulations came into force on 26 February 2015 (bar a few exceptions) and implement in the UK the new Directive on Public Procurement (see below). From 18 April 2016 these regulations were amended by The Public Procurement (Amendments, Repeals and Revocations) Regulations 2016 (see above) - the link immediately above is to the latest (consolidated) version which includes the amendments.",
      "ordinal": 2,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "li",
      "text": "Utilities Contracts Regulations 2016 These Regulations replace the Utilities Contracts Regulations 2006 and are in force from 18 April 2016 in relation to procurements commenced on or after that date.",
      "ordinal": 3,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "Concession Contracts Regulations 2016 These Regulations are in force from 18 April 2016 in relation to procurements commenced on or after that date.",
      "ordinal": 4,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "EU Directives on Public Procurement , Utilities Procurement and Concession Contracts Links to these three Directives, implemented by the Public Contracts Regulations 2015, the Utilities Contracts Regulations 2016 and the Concession Contracts Regulations 2016 (see above).",
      "ordinal": 5,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "Directive 2004/18/EC The \"old\" procurement Directive, also known as the Classic Directive (replaced from 17 April 2014 by the new Directive 2014/24/EU on Public Procurement, see above for link).",
      "ordinal": 6,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "The Public Contracts Regulations 2006 The legislation implementing Directive 2004/18 in England and Wales (replaced on 26 February 2015 by The Public Contracts Regulations 2015; see above). Procurements \"commenced\" prior to 26 February 2015 will still be regulated by the Public Contracts Regulations 2006.",
      "ordinal": 7,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "Directive 2004/17/EC The \"old\" Utilities Directive, governing procurement in the utilities sector (replaced from 17 April 2014 by the new Directive 2014/25/EU on utilities procurement, see above for link).",
      "ordinal": 8,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "The Utilities Regulations 2006 The legislation implementing the \"old\" Utilities Directive in England and Wales (to be replaced by the Utilities Contracts Regulations 2016 from 18 April 2016).",
      "ordinal": 9,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "Directive 2007/66/EC , Directive 89/665/EEC and Directive 92/13/EEC The Remedies Directive (which amended Directive 89/665/EEC (public contracts) and Directive 92/13/EEC (utilities procurement).",
      "ordinal": 10,
      "heading_path": [
        "Useful links",
        "Procurement legislation"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "heading",
      "text": "Find a Tender Service / Contracts Finder",
      "ordinal": 11,
      "heading_path": [
        "Useful links",
        "Find a Tender Service / Contracts Finder"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "Find a Tender Service UK -based service which has replaced the OJEU.",
      "ordinal": 12,
      "heading_path": [
        "Useful links",
        "Find a Tender Service / Contracts Finder"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "Contracts Finder The Contracts Finder portal for advertising tendering opportunities and publishing tender documentation and contracts (in accordance with Part 4 of the Public Contracts Regulations 2015)",
      "ordinal": 13,
      "heading_path": [
        "Useful links",
        "Find a Tender Service / Contracts Finder"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "heading",
      "text": "Model contracts",
      "ordinal": 14,
      "heading_path": [
        "Useful links",
        "Model contracts"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "li",
      "text": "Crown Commercial Service - CCS Model Services Contract This Model Services Contract is intended to replace earlier model contracts issued by the (now defunct) Office of Government Commerce.",
      "ordinal": 15,
      "heading_path": [
        "Useful links",
        "Model contracts"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "li",
      "text": "NHS - Model terms for purchase of goods and services and NHS Standard Contract for Clinical Services Available from the Department of Health together with guidance notes. The former NHS Purchasing and Supply Agency standard NHS terms (e.g. MSCON, SYSCON, SIMCON, FMCON) are no longer maintained and are not available online.",
      "ordinal": 16,
      "heading_path": [
        "Useful links",
        "Model contracts"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "heading",
      "text": "Procurement organisations",
      "ordinal": 17,
      "heading_path": [
        "Useful links",
        "Procurement organisations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "li",
      "text": "Procurement Lawyers' Association UK based association which discusses the law underpinning procurement, prepares papers on current issues and provides input to government consultations.",
      "ordinal": 18,
      "heading_path": [
        "Useful links",
        "Procurement organisations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "li",
      "text": "Chartered Institute of Purchasing and Supply Promotes good procurement practice and offers training courses.",
      "ordinal": 19,
      "heading_path": [
        "Useful links",
        "Procurement organisations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00020",
      "block_type": "li",
      "text": "NHS Supply Chain Provides procurement and supply chain services to NHS bodies.",
      "ordinal": 20,
      "heading_path": [
        "Useful links",
        "Procurement organisations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00021",
      "block_type": "heading",
      "text": "Insightful blogs from our experts",
      "ordinal": 21,
      "heading_path": [
        "Useful links",
        "Procurement organisations",
        "Insightful blogs from our experts"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00022",
      "block_type": "p",
      "text": "We bring you updates and commentary on the latest procurement law news affecting anyone who deals with public procurement as part of their role.",
      "ordinal": 22,
      "heading_path": [
        "Useful links",
        "Procurement organisations",
        "Insightful blogs from our experts"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00023",
      "block_type": "heading",
      "text": "Watch more webinars on-demand",
      "ordinal": 23,
      "heading_path": [
        "Useful links",
        "Procurement organisations",
        "Watch more webinars on-demand"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00024",
      "block_type": "p",
      "text": "View our collection of webinars where our procurement experts address public procurement in the UK, focussing on topics that those working with public procurement need to consider.",
      "ordinal": 24,
      "heading_path": [
        "Useful links",
        "Procurement organisations",
        "Watch more webinars on-demand"
      ],
      "source_locator": null,
      "metadata": {}
