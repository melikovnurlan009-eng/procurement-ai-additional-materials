      "block_type": "heading",
      "text": "Navigating the Procurement Pathway",
      "ordinal": 0,
      "heading_path": [
        "Navigating the Procurement Pathway"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "heading",
      "text": "Plan",
      "ordinal": 1,
      "heading_path": [
        "Navigating the Procurement Pathway",
        "Plan"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "Develop a strategy and plan in line with business objectives and commercial policy outcomes, have clear and transparent commercial pipelines and a good understanding of the market.",
      "ordinal": 2,
      "heading_path": [
        "Navigating the Procurement Pathway",
        "Plan"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "heading",
      "text": "Define",
      "ordinal": 3,
      "heading_path": [
        "Navigating the Procurement Pathway",
        "Plan",
        "Define"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "Identify options and determine relevant procurement requirements that encourage broad participation, and are open and accessible to all.",
      "ordinal": 4,
      "heading_path": [
        "Navigating the Procurement Pathway",
        "Plan",
        "Define"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "heading",
      "text": "Procure",
      "ordinal": 5,
      "heading_path": [
        "Navigating the Procurement Pathway",
        "Plan",
        "Procure"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "Prepare procurement documentation and publish, select suitable suppliers, evaluate bids, award and mobilise the contract.",
      "ordinal": 6,
      "heading_path": [
        "Navigating the Procurement Pathway",
        "Plan",
        "Procure"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Manage",
      "ordinal": 7,
      "heading_path": [
        "Navigating the Procurement Pathway",
        "Plan",
        "Manage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "Establish a contract management plan to monitor performance and ensure successful delivery of contractual obligations, exit and contract closure.",
      "ordinal": 8,
      "heading_path": [
        "Navigating the Procurement Pathway",
        "Plan",
        "Manage"
