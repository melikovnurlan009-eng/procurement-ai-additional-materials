    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Competitive tendering procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "The guidance documents are intended to provide technical guidance and help with interpretation and understanding of the Procurement Act 2023.",
      "ordinal": 3,
      "heading_path": [
        "Competitive tendering procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "The guidance documents should be read in conjunction with the Procurement Act 2023 and its associated regulations and are aimed at procurement practitioners and commercial policy leads in contracting authorities. They are intended to provide technical guidance and help with interpretation and understanding of the Procurement Act 2023.",
      "ordinal": 4,
      "heading_path": [
        "Competitive tendering procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Effective competition and transparency are key enablers of the procurement objectives of delivering value for money and being seen to act with integrity. There are two competitive tendering procedures in the Procurement Act 2023 (Act):",
      "ordinal": 5,
      "heading_path": [
        "Competitive tendering procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "Open procedure.",
      "ordinal": 6,
      "heading_path": [
        "Competitive tendering procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "Competitive flexible procedure.",
      "ordinal": 7,
      "heading_path": [
        "Competitive tendering procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
