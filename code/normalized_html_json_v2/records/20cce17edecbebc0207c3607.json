    {
      "block_id": "b00013",
      "block_type": "heading",
      "text": "Introduction",
      "ordinal": 13,
      "heading_path": [
        "Latest updates",
        "Introduction"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "p",
      "text": "Procurement Pathway signposts to PPNs and Commercial Playbooks, published on GOV.UK. This page is intended to provide an overview of any changes to published PPNs and Commercial Playbooks; helping you stay up to date with what has been archived, updated or newly published on GOV.UK.",
      "ordinal": 14,
      "heading_path": [
        "Latest updates",
        "Introduction"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "p",
      "text": "It remains your responsibility to check whether there are any changes, or outstanding changes, to legislation applicable to your procurement.",
      "ordinal": 15,
      "heading_path": [
        "Latest updates",
        "Introduction"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "heading",
      "text": "Standard commercial templates",
      "ordinal": 16,
      "heading_path": [
        "Latest updates",
        "Standard commercial templates"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "p",
      "text": "Procurement Pathway also hosts a suite of standard commercial templates ('templates').",
      "ordinal": 17,
      "heading_path": [
        "Latest updates",
        "Standard commercial templates"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "p",
      "text": "You can also use this page check if there have been any updates to the templates uploaded to the tool. Templates will be reviewed annually and may be updated on a more regular basis, as and when required.",
      "ordinal": 18,
      "heading_path": [
        "Latest updates",
        "Standard commercial templates"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "p",
      "text": "To ensure you are using the latest version of documents and templates, you should download directly from the tool. You can find available templates by searching for the term 'templates'.",
      "ordinal": 19,
      "heading_path": [
        "Latest updates",
        "Standard commercial templates"
      ],
      "source_locator": null,
      "metadata": {}
    },
