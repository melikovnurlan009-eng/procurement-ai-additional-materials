      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00023",
      "block_type": "li",
      "text": "Disposal costs such as decommissioning, dismantling and final disposal",
      "ordinal": 23,
      "heading_path": [
        "Life Cycle Impact Mapping",
