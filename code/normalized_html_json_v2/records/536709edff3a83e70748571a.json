      "block_type": "table",
      "text": "impacts of obtaining raw materials\timpacts of manufacturing & logistics\nimpacts during delivery of product/service\timpacts at end-of-life/disposal",
      "ordinal": 7,
      "heading_path": [
        "Life Cycle Impact Mapping"
      ],
