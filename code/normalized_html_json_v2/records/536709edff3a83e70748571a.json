      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00027",
      "block_type": "li",
      "text": "Training costs",
      "ordinal": 27,
      "heading_path": [
        "Life Cycle Impact Mapping",
        "Life Cycle Costing"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00028",
