      "ordinal": 0,
      "heading_path": [
        "Choice of procedures"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Finalise and publish procurement pack",
      "ordinal": 1,
      "heading_path": [
        "Choice of procedures"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Choice of procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation requires contracting authorities to apply the procedures within Part 2 of the PCR 2015 when awarding public contracts and to advertise procurement opportunities by the publication of a contract notice.",
      "ordinal": 3,
      "heading_path": [
        "Choice of procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "This regulation also explains the situations in which a competitive procedure with negotiation or a competitive dialogue procedure may be used.",
      "ordinal": 4,
      "heading_path": [
        "Choice of procedures",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 5,
      "heading_path": [
        "Choice of procedures",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "With the exception of the negotiated procedure without prior publication, procurement opportunities must be advertised by means of publishing a contract notice.",
      "ordinal": 6,
      "heading_path": [
        "Choice of procedures",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 7,
      "heading_path": [
        "Choice of procedures",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 8,
      "heading_path": [
        "Choice of procedures",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "ensure that the procurement documents identify the correct procurement procedure",
      "ordinal": 9,
      "heading_path": [
        "Choice of procedures",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "advertise procurement opportunities only by means of a contract notice.",
      "ordinal": 10,
      "heading_path": [
        "Choice of procedures",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 11,
      "heading_path": [
        "Choice of procedures",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 12,
      "heading_path": [
        "Choice of procedures",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
