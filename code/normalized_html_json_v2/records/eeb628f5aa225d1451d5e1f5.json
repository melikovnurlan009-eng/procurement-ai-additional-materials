      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 18,
      "heading_path": [
        "Carbon reduction contract schedule",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "li",
      "text": "read the PPN and any supporting implementation guidance",
      "ordinal": 19,
      "heading_path": [
        "Carbon reduction contract schedule",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
