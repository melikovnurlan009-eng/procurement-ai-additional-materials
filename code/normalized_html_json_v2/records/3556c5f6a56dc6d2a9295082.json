      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 14,
      "heading_path": [
        "Means of proof",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "li",
      "text": "read the regulation",
      "ordinal": 15,
      "heading_path": [
        "Means of proof",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
