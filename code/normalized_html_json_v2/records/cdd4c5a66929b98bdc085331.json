    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "You can subscribe to receive automatic emails when any changes/updates have been made to the Procurement Journey. This will ensure you stay up to date with any new developments/information.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "We will only use the personal information you provide to send automated emails notifying you of changes: we will not use these details to contact you for any other purpose.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "To subscribe click on \"Notify Me of Changes\" located in the top right hand corner of any Procurement Journey page and then complete your name and e-mail address, as below.",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "T hat's it! You have successfully subscribed and will receive all future emails sent telling you of any changes made.",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    }
