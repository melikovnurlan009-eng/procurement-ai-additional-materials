    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Manage > Manage and monitor",
      "ordinal": 1,
      "heading_path": [
        "Retention of contract copies"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Retention of contract copies",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that contracting authorities are required to keep copies of all contracts with a value equal to or greater than £884,720 for supply or service contracts, and £8,847,200 for works contracts. Copies must be kept for at least the duration of such contracts. Contracting authorities are also required to grant access to these contracts but may deny access to specific documents or information based on the applicable rules on access to documents and data protection laws.",
      "ordinal": 3,
      "heading_path": [
        "Retention of contract copies",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Retention of contract copies",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Copies of concluded contracts should be kept, at least for the duration of the contract, if the value exceeds £884,720 for supply or service contracts, and £8,847,200 for works contracts. Access to these contracts must be granted except where the rules on access to documents and data protection laws apply.",
      "ordinal": 5,
      "heading_path": [
        "Retention of contract copies",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Retention of contract copies",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Retention of contract copies",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "ensure that they keep a record of contracts concluded, at least for the duration of such contracts, if the value exceeds £884,720 for supply or service contracts, and £8,847,200 for works contracts",
      "ordinal": 8,
      "heading_path": [
        "Retention of contract copies",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "grant access to concluded contracts, unless access can be denied in accordance with applicable rules relating to access to documents and data protection.",
      "ordinal": 9,
      "heading_path": [
        "Retention of contract copies",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 10,
      "heading_path": [
        "Retention of contract copies",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
