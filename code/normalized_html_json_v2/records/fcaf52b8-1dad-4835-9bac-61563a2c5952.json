  "title": "Procurement Policy Note 02/15: Public Contracts Regulations 2015",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0215-public-contracts-regulations-2015",
  "description": "The Public Contracts Regulations 2015 have been laid in Parliament and come into force on 26 February 2015.",
  "publication_date": "2015-02-06T19:23:00+00:00",
  "updated_date": "2015-02-06T19:23:00+00:00",
  "source_metadata": {
