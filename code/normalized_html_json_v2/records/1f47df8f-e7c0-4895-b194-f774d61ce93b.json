  "logical_structure": [],
  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) is now out of date.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "The new standard forms and notices for procurements under the Public Contracts Regulations 2015 have been published in the Official Journal of the EU. They come into force on 3 December 2015.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "Contracting authorities should use the new standard forms and notices for procurements under the Public Contracts Regulations 2015. They should stop using the current forms and notices as soon as the new ones become available on Tenders Electronic Daily (TED) eNotices or via TED e-Senders system.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
