  "logical_structure": [],
  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note ( PPN ) and guidance is now out of date.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "When reviewing this PPN , please refer to PPN 04/20: Recovery and Transition from COVID-19 which updates and builds on the provisions contained in PPN 02/20.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "This Procurement Policy Note ( PPN ) sets out information and guidance for public bodies on payment of their suppliers to ensure service continuity during and after the current coronavirus (COVID-19) outbreak. Contracting authorities must act now to ensure suppliers at risk are in a position to resume normal contract delivery once the outbreak is over.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "The guidance note ‘Model interim payment terms’ provides a set of terms that contracting authorities can use to implement PPN 02/20 in providing contractual relief to suppliers who have been affected by coronavirus (COVID-19).",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "The guidance note ‘Payments to suppliers for contingent workers’ provides guidance for contracting authorities where they have contingent workers impacted by coronavirus (COVID-19) and is updated with the latest frequently asked questions (FAQs).",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Frequently asked questions (FAQs) - latest FAQs on PPN 02/20.",
      "ordinal": 5,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
