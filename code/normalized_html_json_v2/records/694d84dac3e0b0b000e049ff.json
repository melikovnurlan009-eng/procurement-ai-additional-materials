    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Introduction of Find a Tender",
      "ordinal": 0,
      "heading_path": [
        "Introduction of Find a Tender"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Contract award and implementation",
      "ordinal": 1,
      "heading_path": [
        "Introduction of Find a Tender"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Introduction of Find a Tender",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This PPN applies to all contracting authorities, including central government departments, executive agencies, non-departmental public bodies, wider public sector, local authorities, NHS bodies, and utilities in respect of procurements regulated by the Public Contracts Regulations 2015 (PCR 2015), the utilities Contracts Regulations 2016, the Concession Contracts Regulations 2016 and the Defence and Security Public Contracts Regulations 2011 (collectively referred to as ‘contracting authorities').",
      "ordinal": 3,
      "heading_path": [
        "Introduction of Find a Tender",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "This PPN reminds contracting authorities of the UK e-notification service (Find a Tender or ‘FTS’), where notices for procurements (from the end of the transition period) are required to be published. The PPN also provides advice on notice publication for contracting authorities whose procurements commenced prior to the end of the transition period.",
      "ordinal": 4,
      "heading_path": [
        "Introduction of Find a Tender",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Contracting authorities have legal obligations under the aforementioned regulations to publish certain notices in relation to public procurements. All legal and policy requirements to advertise on other platforms such as Contracts Finder and MOD Defence Contracts Online or Public Contracts Scotland, Sell2Wales, eSourcing NI and eTendersNI are not affected by the requirement to publish certain notices on FTS.",
      "ordinal": 5,
      "heading_path": [
        "Introduction of Find a Tender",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Introduction of Find a Tender",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contract award notices must be published on FTS, including where they relate to the award of a contract, conclusion of a framework agreement, or award of a contract under a Dynamic Purchasing System where those procurements commenced after the end of the transition period.",
      "ordinal": 7,
      "heading_path": [
        "Introduction of Find a Tender",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 8,
      "heading_path": [
        "Introduction of Find a Tender",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 9,
      "heading_path": [
        "Introduction of Find a Tender",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "for procurements commenced after the end of the transition period, publish contract award notices on FTS where they relate to above-threshold procurements, including: conclusion of framework agreements contracts awarded pursuant to the negotiated procedure without prior publication under regulation 32 of PCR 2015 (use of negotiated procedure without prior publication), and contracts awarded under a DPS.",
      "ordinal": 10,
      "heading_path": [
        "Introduction of Find a Tender",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "conclusion of framework agreements",
      "ordinal": 11,
      "heading_path": [
        "Introduction of Find a Tender",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "contracts awarded pursuant to the negotiated procedure without prior publication under regulation 32 of PCR 2015 (use of negotiated procedure without prior publication), and",
      "ordinal": 12,
      "heading_path": [
        "Introduction of Find a Tender",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "contracts awarded under a DPS.",
      "ordinal": 13,
      "heading_path": [
        "Introduction of Find a Tender",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
