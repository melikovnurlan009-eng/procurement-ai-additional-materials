    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Pre-Award",
      "ordinal": 2,
      "heading_path": [
        "Pre-Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "Before formally awarding the contract:",
      "ordinal": 3,
      "heading_path": [
        "Pre-Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "Finalise contract terms: Ensure all obligations, Key Performance Indicators (KPIs), milestones, service levels are clearly defined.",
      "ordinal": 4,
      "heading_path": [
        "Pre-Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "Verify financial standing: Confirm supplier solvency, insurance, guarantees, and any parent company support.",
      "ordinal": 5,
      "heading_path": [
        "Pre-Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "Risk assessment update: Confirm that all medium-to-high risks have mitigation measures, assigned owners, and escalation routes.",
      "ordinal": 6,
      "heading_path": [
        "Pre-Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "Internal approvals: Obtain all necessary approvals from senior management or steering boards.",
      "ordinal": 7,
      "heading_path": [
        "Pre-Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "Stakeholder engagement: Notify relevant internal teams, e.g., finance, operations, legal, I.T., technical leads, User Intelligence Groups (UIGs) and external stakeholders (if relevant).",
      "ordinal": 8,
      "heading_path": [
        "Pre-Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "Document control: Ensure the final contract, schedules, and supporting documentation are properly versioned and stored.",
      "ordinal": 9,
      "heading_path": [
        "Pre-Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "heading",
      "text": "Formal Contract Award",
      "ordinal": 10,
      "heading_path": [
        "Pre-Award",
        "Formal Contract Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "p",
      "text": "Award notification: Send formal letters via Public Contracts Scotland (PCS) or direct communication, including standstill periods if applicable.",
      "ordinal": 11,
      "heading_path": [
        "Pre-Award",
        "Formal Contract Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
