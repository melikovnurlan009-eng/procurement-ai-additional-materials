      "block_type": "p",
      "text": "Record decision: Document the award decision, including rationale, evaluation scores, and approvals.",
      "ordinal": 12,
      "heading_path": [
        "Pre-Award",
        "Formal Contract Award"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
