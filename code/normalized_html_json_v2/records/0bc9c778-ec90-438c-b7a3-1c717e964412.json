    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) reminds contracting authorities of the options available to them when undertaking procurements in an emergency.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This includes extremely urgent procurements required by the ongoing response to the COVID-19 pandemic and this PPN builds on the guidance in “ PPN 01/20 - Responding to COVID-19 ”. It includes further information on the commercial risks inherent in direct awards without competition.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
