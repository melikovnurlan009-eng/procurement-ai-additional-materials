  "title": "Procurement Policy Note 06/21: Taking account of Carbon Reduction Plans in the procurement of major government contracts",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0621-taking-account-of-carbon-reduction-plans-in-the-procurement-of-major-government-contracts",
  "description": "This note sets out how to take account of Carbon Reduction Plans in the procurement of major central government contracts.",
  "publication_date": "2021-06-05T14:00:00+01:00",
  "updated_date": "2023-04-17T12:08:13+01:00",
  "source_metadata": {
    "content_id": "e1847f4b-5953-4cd9-a9c7-3eae0908c268",
    "base_path": "/government/publications/procurement-policy-note-0621-taking-account-of-carbon-reduction-plans-in-the-procurement-of-major-government-contracts",
    "document_type": "guidance",
