      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 17,
      "heading_path": [
        "Electronic availability of procurement documents",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
