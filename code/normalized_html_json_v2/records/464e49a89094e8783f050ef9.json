      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 17,
      "heading_path": [
        "Restricted procedure",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
