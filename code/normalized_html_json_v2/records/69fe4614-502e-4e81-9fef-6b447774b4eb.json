  "title": "Procurement Policy Note 03/15: reforms to make public procurement more accessible to SMEs",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0315-reforms-to-make-public-procurement-more-accessible-to-smes",
  "description": "New reforms will make public contracts more accessible to businesses, and in particular to small and medium-sized enterprises (SMEs).",
  "publication_date": "2015-02-18T11:02:00+00:00",
  "updated_date": "2015-03-04T18:31:11+00:00",
  "source_metadata": {
    "content_id": "69fe4614-502e-4e81-9fef-6b447774b4eb",
    "base_path": "/government/publications/procurement-policy-note-0315-reforms-to-make-public-procurement-more-accessible-to-smes",
