  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) launches a new model to deliver social value through government’s commercial activities. Central government organisations should use this model to take account of the additional social benefits that can be achieved in the delivery of its contracts, using policy outcomes aligned with this government’s priorities.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "The Social Value Model, guide to using the model and quick reference table are attached as separate pdf documents.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
