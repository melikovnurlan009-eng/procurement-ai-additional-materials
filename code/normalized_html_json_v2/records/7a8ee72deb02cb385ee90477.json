    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "PPN 011 Commercial playbooks",
      "ordinal": 0,
      "heading_path": [
        "PPN 011 Commercial playbooks"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Define > Assess the market",
      "ordinal": 1,
      "heading_path": [
        "PPN 011 Commercial playbooks"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "PPN 011 Commercial playbooks"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This PPN applies to all central government departments, their executive agencies and non-departmental public bodies (collectively referred to as 'in-scope organisations') when awarding public contracts for goods and or services, and or works, other than special regime contracts. Other public sector contracting authorities may wish to apply the approach set out in this PPN.",
      "ordinal": 3,
      "heading_path": [
        "PPN 011 Commercial playbooks"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "The Commercial Playbooks, and accompanying guidance notes, outline guidance for commercial teams in order to improve decision-making and ensure the assessment, procurement and management of public services delivers better outcomes and value for money for the public.",
      "ordinal": 4,
      "heading_path": [
        "PPN 011 Commercial playbooks"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Note: This PPN replaces PPN 06/23 for procurements commencing on or after 24 February 2025.",
      "ordinal": 5,
      "heading_path": [
        "PPN 011 Commercial playbooks"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "PPN 011 Commercial playbooks",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "To provide best practice guidance aimed at ensuring that projects and programmes are set up correctly from the start. This is achieved by focusing on effective sourcing and contracting, which helps in improving decision-making, managing risks, incorporating sustainability, fostering innovation, and ultimately delivering better outcomes and value for money in public sector projects.",
      "ordinal": 7,
      "heading_path": [
        "PPN 011 Commercial playbooks",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 8,
      "heading_path": [
        "PPN 011 Commercial playbooks",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "In-scope organisations should:",
      "ordinal": 9,
      "heading_path": [
        "PPN 011 Commercial playbooks",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "read the relevant Commercial Playbook and any supporting guidance note(s)",
      "ordinal": 10,
      "heading_path": [
        "PPN 011 Commercial playbooks",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 11,
      "heading_path": [
        "PPN 011 Commercial playbooks",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
