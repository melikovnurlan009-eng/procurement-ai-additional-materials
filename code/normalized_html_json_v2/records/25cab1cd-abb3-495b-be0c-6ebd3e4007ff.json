    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) is now out of date. Please refer to PPN 10/21: Thresholds & Inclusion of VAT",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This PPN provides advanced notification of the new threshold levels to apply for the purposes of the Public Contracts Regulations 2015, Utilities Contracts Regulations 2016, Concession Contracts Regulations 2016 and the Defence and Security Public Procurement Regulations 2011, with effect from 1 January 2020. The contents of this PPN apply to all Central Government Departments, their Executive Agencies and Non Departmental Public Bodies.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
