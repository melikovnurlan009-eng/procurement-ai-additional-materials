  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) provides the revised standard Selection Questionnaire (SQ) template and guidance. It replaces the current standard Pre-Qualification Questionnaire (PQQ). This PPN supersedes the guidance on supplier selection and PQQs in PPN 03/15.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This PPN applies to all contracting authorities in England, and contracting authorities in Wales and Northern Ireland that exercise wholly or mainly reserved functions for procurements above the thresholds laid down in the Public Contracts Regulations 2015 (PCR 2015). Please circulate this PPN within your organisation, drawing it to the attention of those with a purchasing role.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
