    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "We recently mentioned some upcoming changes regarding the new UK Trade Agreements with Australia and New Zealand . These legislative changes are now live.",
      "ordinal": 2,
      "heading_path": [
        "Information Notice"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "These changes will update guidance on the following areas:",
      "ordinal": 3,
      "heading_path": [
        "Information Notice"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "using PINs (Prior Information Notice) as a call for competition (any references to such are now being removed)",
      "ordinal": 4,
      "heading_path": [
        "Information Notice"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "estimating the prices of contracts and",
      "ordinal": 5,
      "heading_path": [
        "Information Notice"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "terminating contracts",
      "ordinal": 6,
      "heading_path": [
        "Information Notice"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Please refer to Scottish Public Procurement Note Public procurement – Australia and New Zealand Free Trade Agreements (SPPN 1/2023) for more information on these changes.",
      "ordinal": 7,
      "heading_path": [
        "Information Notice"
      ],
