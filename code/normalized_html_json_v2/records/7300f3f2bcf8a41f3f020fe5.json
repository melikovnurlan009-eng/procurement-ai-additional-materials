  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "li",
      "text": "View PDF",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This Route provides guidance and templates for procurements that are:",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "li",
      "text": "low value ( a total estimated value of under £50k excluding VAT)",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "li",
      "text": "low risk and",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "non-repetitive.",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "This Procurement Journey Route should only be used by individuals who are authorised to procure for their Scottish public sector organisation.",
      "ordinal": 5,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "You do not need extensive purchasing training, however it is assumed that you have an awareness of:",
      "ordinal": 6,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "EU regulations",
      "ordinal": 7,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "applicable local procurement policies, guidelines and governance arrangements.",
      "ordinal": 8,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "If your procurement does not meet the above requirements, or you do not have the authority to procure, contact your Procurement Function or Centre of Expertise (CoE) .",
      "ordinal": 9,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "p",
      "text": "Route 1 Objectives",
      "ordinal": 10,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "p",
      "text": "The main objectives of this Route are to:",
      "ordinal": 11,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "provide a step-by-step guide to conduct a low value and low risk procurement exercise;",
      "ordinal": 12,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "provide a set of guides and templates that can be used to collate and analyse the data required for a Route 1 procurement exercise;",
      "ordinal": 13,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "li",
      "text": "standardise the Scottish public sector procurement process across organisations for low value procurements;",
      "ordinal": 14,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "li",
      "text": "highlight the minimum legal and policy obligations involved at each stage of the process.",
      "ordinal": 15,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "p",
      "text": "Before carrying on, please check you have everything you need:",
      "ordinal": 16,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "li",
      "text": "Budgetary sign off and sponsorship.",
      "ordinal": 17,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "li",
      "text": "Individuals with relevant experience to evaluate responses and write the brief.",
      "ordinal": 18,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "li",
      "text": "Timescale plan.",
      "ordinal": 19,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00020",
      "block_type": "heading",
      "text": "Considerations Before Proceeding",
      "ordinal": 20,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00021",
      "block_type": "p",
      "text": "Before you start your Procurement Journey, please consider the following points:",
      "ordinal": 21,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00022",
      "block_type": "li",
      "text": "Is the product/service you are buying business critical?",
      "ordinal": 22,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00023",
      "block_type": "li",
      "text": "Is there a significant risk to your Organisation's reputation or ability to deliver if something went wrong with what you are buying?",
      "ordinal": 23,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00024",
      "block_type": "li",
      "text": "Is the estimated value of the goods/services that you are buying more than £50,000 over the lifetime of the contract? If so, this means that Route 1 cannot be used as the contract needs to be advertised and formally tendered.",
      "ordinal": 24,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00025",
      "block_type": "p",
      "text": "To calculate the estimated value of the contract you should add the spend for the full contract duration, including any contract extensions.",
      "ordinal": 25,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00026",
      "block_type": "p",
      "text": "For example, a contract of £10,000 per year (excluding VAT) over three years plus a 1 year £10,000 extension (excluding VAT) is a £40,000 contract i.e. 3 x £10,000 + £10,000.",
      "ordinal": 26,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00027",
      "block_type": "p",
      "text": "Please note, requirements must not be 'split' into contracts of lower value, or contracts reduced in duration, to avoid the need to advertise/conduct a full tender exercise.",
      "ordinal": 27,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00028",
      "block_type": "li",
      "text": "Are existing contracts already available that you could use e.g. call off from?",
      "ordinal": 28,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00029",
      "block_type": "li",
      "text": "Does your Organisation have a lower advertising threshold? If so, should you follow the Route 2 process ? This information will be held with your Finance Department or Procurement Function",
      "ordinal": 29,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00030",
      "block_type": "li",
      "text": "Is there a conflict of interest? Do you or someone in your organisation stand to benefit from the outcome of the procurement? For example: benefit financially? Have friendships with suppliers? Previously worked for suppliers? If so should the buyer and/or evaluating team be changed?",
      "ordinal": 30,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00031",
      "block_type": "p",
      "text": "If you have answered 'yes' to any of the above questions please contact your local Procurement Function or Centre of Expertise (CoE) before proceeding.",
      "ordinal": 31,
      "heading_path": [
        "Considerations Before Proceeding"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00032",
      "block_type": "heading",
      "text": "Audit Requirements",
      "ordinal": 32,
      "heading_path": [
        "Considerations Before Proceeding",
        "Audit Requirements"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00033",
      "block_type": "p",
      "text": "You should keep a file for your Route 1 procurement documents, in case of future audit.",
      "ordinal": 33,
      "heading_path": [
        "Considerations Before Proceeding",
        "Audit Requirements"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00034",
      "block_type": "p",
      "text": "You should make sure you are familiar with:",
      "ordinal": 34,
      "heading_path": [
        "Considerations Before Proceeding",
        "Audit Requirements"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00035",
      "block_type": "li",
      "text": "your Organisation's document retention policy; and",
      "ordinal": 35,
      "heading_path": [
        "Considerations Before Proceeding",
        "Audit Requirements"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00036",
      "block_type": "li",
      "text": "any guidance which may impact on the project before starting.",
      "ordinal": 36,
      "heading_path": [
        "Considerations Before Proceeding",
        "Audit Requirements"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00037",
      "block_type": "p",
      "text": "Please note that purchases of goods and services may routinely be the subject of Freedom of Information (FoI) requests.",
      "ordinal": 37,
      "heading_path": [
        "Considerations Before Proceeding",
        "Audit Requirements"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00038",
      "block_type": "heading",
      "text": "You are now ready to begin Route 1 of the Procurement Journey.",
      "ordinal": 38,
      "heading_path": [
        "Considerations Before Proceeding",
        "Audit Requirements",
        "You are now ready to begin Route 1 of the Procurement Journey."
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00039",
      "block_type": "p",
      "text": "Please ensure this guidance is used in conjunction with the internal governance, policies and procedures for your Organisation.",
      "ordinal": 39,
      "heading_path": [
        "Considerations Before Proceeding",
        "Audit Requirements",
        "You are now ready to begin Route 1 of the Procurement Journey."
      ],
      "source_locator": null,
      "metadata": {}
    }
  ],
