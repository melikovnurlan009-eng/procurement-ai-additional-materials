  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) is now out of date. Please refer to PPN 10/21: Thresholds & Inclusion of VAT",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This note provides contracting authorities and utilities with the threshold levels to apply for the purposes of the Concession Contracts Regulations 2016 with effect from 18th April 2016.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "This PPN supplements PPN18/15, which provides a summary of the threshold levels for public contracts, utilities contracts and defence and security contracts from 1st January 2016. As the Concession Contracts Regulations did not come into force until the 18th April 2016 the threshold for concessions was not included in PPN18/15.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
