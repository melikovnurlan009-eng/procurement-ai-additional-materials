    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Contracts subsidised by contracting authorities",
      "ordinal": 0,
      "heading_path": [
        "Contracts subsidised by contracting authorities"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Plan > Strategy and plan",
      "ordinal": 1,
      "heading_path": [
        "Contracts subsidised by contracting authorities"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that Part 2 PCR 2015 will apply to certain above threshold works or services contracts which are subsidised directly by a contracting authority by more than 50% of the contract value.",
      "ordinal": 3,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "Regulation 13 applies to above threshold works contracts involving any of the civil engineering activities listed in schedule 2 of the PCR 2015, or any building work for hospitals, facilities intended for sports, recreation or leisure, school or university buildings.",
      "ordinal": 4,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Regulation 13 will apply to above threshold services contracts connected to any of the works mentioned above.",
      "ordinal": 5,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "Where Regulation 13 applies, the contracting authority must ensure that the subsidised contract is awarded in compliance with Part 2 PCR 2015.",
      "ordinal": 6,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 7,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "Part 2 PCR will apply to certain above threshold works or services contracts subsidised directly by a contracting authority by more than 50% of the contract value. Contracting authorities must ensure that the entity awarding the subsidised contract complies with Part 2 PCR.",
      "ordinal": 8,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 9,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 10,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "ensure any contracts subsidised directly by a contracting authority are reviewed and consideration is given as to whether this regulation, i.e. regulation 13 (and Part 2 PCR), will apply.",
      "ordinal": 11,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 12,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "p",
      "text": "There is no direct equivalent section in the Procurement Act 2023.",
      "ordinal": 13,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
