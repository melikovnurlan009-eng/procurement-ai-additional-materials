        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 15,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "li",
      "text": "read the regulation",
      "ordinal": 16,
      "heading_path": [
        "Contracts subsidised by contracting authorities",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 17,
