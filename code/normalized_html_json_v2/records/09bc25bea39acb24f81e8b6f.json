    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Plan > Strategy and plan",
      "ordinal": 1,
      "heading_path": [
        "Composition of the jury"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Composition of the jury",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that juries for design contests must be made up of individuals who are independent of participants in the contest. If a professional qualification is required from participants, at least one third of the jury members must have the required professional qualifications.",
      "ordinal": 3,
      "heading_path": [
        "Composition of the jury",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Composition of the jury",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "The jury must be independent, and where a professional qualification is required from participants, at least one third of the jury members must have the required qualification.",
      "ordinal": 5,
      "heading_path": [
        "Composition of the jury",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Composition of the jury",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Composition of the jury",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "when organising a design contest, ensure that the jury is independent and that where a professional qualification is required from participants, at least one third of the jury members have the required qualification.",
      "ordinal": 8,
      "heading_path": [
        "Composition of the jury",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 9,
      "heading_path": [
        "Composition of the jury",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "p",
      "text": "There is no direct equivalent section in the Procurement Act 2023",
      "ordinal": 10,
      "heading_path": [
        "Composition of the jury",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
