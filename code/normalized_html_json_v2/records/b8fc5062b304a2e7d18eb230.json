        "Exclusion grounds",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "li",
      "text": "Section 58: Considering whether a supplier is excluded or excludable",
      "ordinal": 18,
      "heading_path": [
