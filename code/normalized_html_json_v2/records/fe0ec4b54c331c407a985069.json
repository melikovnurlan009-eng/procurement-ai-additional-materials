      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "The Sourcing Playbook is best practice guidance aimed at commercial / procurement, finance, project delivery, policy, and any professionals across the public sector who are responsible for the planning and delivery of insourcing and outsourcing services.",
      "ordinal": 3,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "It sets out how to make sourcing decisions, and deliver public services in partnership with the private and third sectors with a focus on getting it right from the start.",
      "ordinal": 4,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "There are three other sector specific Commercial Playbooks that should be referred to when your procurement fits within their scope:",
      "ordinal": 5,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "Digital, Data and Technology (DDaT) Playbook",
      "ordinal": 6,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "Construction Playbook",
      "ordinal": 7,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
