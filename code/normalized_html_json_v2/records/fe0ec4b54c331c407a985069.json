      "ordinal": 8,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 9,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "read the relevant Commercial Playbook and any supporting Guidance Note(s)",
      "ordinal": 10,
      "heading_path": [
        "Sourcing Playbook",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 11,
      "heading_path": [
