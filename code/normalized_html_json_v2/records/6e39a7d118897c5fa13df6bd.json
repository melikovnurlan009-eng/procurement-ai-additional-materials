  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Variants",
      "ordinal": 0,
      "heading_path": [
        "Variants"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Evaluation stage",
      "ordinal": 1,
      "heading_path": [
        "Variants"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Variants",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation allows contracting authorities to authorise, or require, tenderers to submit variant tenders provided that this is set out in the contract notice and, procurement documents should set out the minimum requirements to be met by variants; including any specific requirements for their presentation.",
      "ordinal": 3,
      "heading_path": [
        "Variants",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "To the extent that the submission of variant tenders is authorised or required, contracting authorities must ensure that variant tenders are linked to the subject-matter of the contract and chosen award criteria can be applied to variants meeting minimum requirements; as well as to conforming tenders which are not variants.",
      "ordinal": 4,
      "heading_path": [
        "Variants",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Variant tenders may only be evaluated where they meet the contracting authority’s minimum requirements and must not be rejected on the sole ground that they would, where successful, lead to a public service or supply contract (rather than a public supply or service contract).",
      "ordinal": 5,
      "heading_path": [
        "Variants",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Variants",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Variant tenders must conform to the minimum requirements set out in the procurement documents and must not be rejected on the sole ground that they would, where successful, lead to a public service or supply contract (rather than a public supply or service contract).",
      "ordinal": 7,
      "heading_path": [
        "Variants",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 8,
      "heading_path": [
        "Variants",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 9,
      "heading_path": [
        "Variants",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "ensure that variant tenders are evaluated only where they satisfy the minimum requirements as set out in the procurement documents",
      "ordinal": 10,
      "heading_path": [
        "Variants",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "ensure that evaluators apply the award criteria fairly and consistently to variant and non-variant tenders",
      "ordinal": 11,
      "heading_path": [
        "Variants",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "ensure that evaluators do not seek to disqualify variant tenders on the sole ground that they would, where successful, lead to a public service or supply contract (rather than a public supply or service contract).",
      "ordinal": 12,
      "heading_path": [
        "Variants",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 13,
      "heading_path": [
        "Variants",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "p",
      "text": "There is no direct equivalent section in the Procurement Act 2023.",
      "ordinal": 14,
      "heading_path": [
        "Variants",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "heading",
      "text": "Additional support and guidance",
      "ordinal": 15,
      "heading_path": [
        "Variants",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 16,
      "heading_path": [
        "Variants",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "li",
      "text": "read the regulation",
      "ordinal": 17,
      "heading_path": [
        "Variants",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 18,
      "heading_path": [
        "Variants",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
