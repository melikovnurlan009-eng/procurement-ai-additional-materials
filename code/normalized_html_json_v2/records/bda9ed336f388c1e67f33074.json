  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Contract award notices",
      "ordinal": 0,
      "heading_path": [
        "Contract award notices"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Contract award and implementation",
      "ordinal": 1,
      "heading_path": [
        "Contract award notices"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Contract award notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation requires contracting authorities to publish a contract award notice detailing the results of the procurement procedure within 30 days of the award of a contract, or the conclusion of a framework agreement. Different rules apply to contracts awarded under a framework agreement or contracts awarded under a Dynamic Purchasing System (DPS); contracting authorities must refer to relevant and applicable rules to ensure compliance for those contracts. When publishing a contract award notice, this must be submitted for publication in accordance with the requirements of regulation 51 PCR 2015 (publication on the UK e-notification service).",
      "ordinal": 3,
      "heading_path": [
        "Contract award notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "Additionally, this regulation sets out the information that must be included in a contract award notice and the circumstances in which it would be permissible to withhold from publication relevant information relating to the award of the contract.",
      "ordinal": 4,
      "heading_path": [
        "Contract award notices",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 5,
      "heading_path": [
        "Contract award notices",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "A contract award notice should be published on the UK’s e-notification service (i.e. the \"Find a Tender\" service), detailing the results of the procurement procedure.",
      "ordinal": 6,
      "heading_path": [
        "Contract award notices",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 7,
      "heading_path": [
        "Contract award notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 8,
      "heading_path": [
        "Contract award notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "ensure that time-limits for the publication of contract award notices are observed, including where a quarterly publication option is selected within the context of contracts awarded under a Dynamic Purchasing System",
      "ordinal": 9,
      "heading_path": [
        "Contract award notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "li",
      "text": "ensure that contract award notices contain the required information as set out in Part D of Annex 5 of the Public Contracts Directive and as amended by this regulation (i.e. regulation 50)",
      "ordinal": 10,
      "heading_path": [
        "Contract award notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "ensure that any information withheld from the contract award notice (that would otherwise be required under Part D of Annex 5 of the Public Contracts Directive) is done so in accordance with the exemptions set out in this regulation (i.e. regulation 50).",
      "ordinal": 11,
      "heading_path": [
        "Contract award notices",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 12,
      "heading_path": [
        "Contract award notices",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 13,
      "heading_path": [
        "Contract award notices",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "li",
      "text": "Section 53: Contract details notices and publication of contracts",
      "ordinal": 14,
      "heading_path": [
        "Contract award notices",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "li",
      "text": "Section 87: Regulated below-threshold contracts: notices",
      "ordinal": 15,
      "heading_path": [
