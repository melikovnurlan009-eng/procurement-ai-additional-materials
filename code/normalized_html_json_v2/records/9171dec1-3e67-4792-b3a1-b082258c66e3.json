  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "The Public Contracts Regulations 2015 (PCRs) includes obligations on in-scope organisations to make public sector opportunities available in one place, on Contracts Finder. Contract award information relating to the winning contractor should also be made available on Contracts Finder. This Procurement Policy Note (PPN) updates guidance for contracting authorities on the requirements to publish this information following the commencement of the Procurement Act 2023. This PPN and its associated guidance on the transparency requirements for publishing on Contracts Finder only applies to procurements that were commenced under the PCRs. This PPN replaces PPN 01/23",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
