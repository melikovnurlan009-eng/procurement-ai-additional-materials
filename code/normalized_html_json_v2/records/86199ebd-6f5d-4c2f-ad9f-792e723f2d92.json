  "title": "PPN 04/23 - Example Contract Clause (HTML)",
  "canonical_url": "https://www.gov.uk/government/publications/ppn-0423-procuring-steel-in-government-contracts/ppn-0423-example-contract-clause-html",
  "description": null,
