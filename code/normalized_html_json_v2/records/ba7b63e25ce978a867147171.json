    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Contract award and implementation",
      "ordinal": 1,
      "heading_path": [
        "Confidentiality"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Confidentiality",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that contracting authorities must not disclose information that has been designated as confidential by a supplier (i.e. economic operator); including technical or trade secrets and confidential aspects of tenders. The requirement not to disclose confidential information is subject to certain exceptions as referred to in this regulation. Additionally, contracting authorities are permitted to set requirements for suppliers to protect the confidentiality of information that they share during the procurement process.",
      "ordinal": 3,
      "heading_path": [
        "Confidentiality",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Confidentiality",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Confidential information obtained from suppliers during the procurement process should not be disclosed by the contracting authority when awarding and implementing the public contract.",
      "ordinal": 5,
      "heading_path": [
        "Confidentiality",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Confidentiality",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Confidentiality",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "ensure appropriate steps are taken during the award and implementation of the contract to protect confidential information made available by suppliers during the procurement process.",
      "ordinal": 8,
      "heading_path": [
        "Confidentiality",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 9,
      "heading_path": [
        "Confidentiality",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 10,
      "heading_path": [
        "Confidentiality",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "Section 30: Excluding suppliers for improper behaviour",
      "ordinal": 11,
      "heading_path": [
        "Confidentiality",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "Section 94: General exemptions from duties to publish or disclose information",
      "ordinal": 12,
      "heading_path": [
