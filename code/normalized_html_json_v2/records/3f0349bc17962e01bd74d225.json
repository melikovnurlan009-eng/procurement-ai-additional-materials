    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Subject-matter and scope of Part 2",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation confirms that above-threshold, non-excluded public contracts and design contests are subject to Part 2 PCR 2015. It also states that the UK is not obliged to disclose information which it considers contrary to its essential security interests and that the UK may take measures to protect its essential security interests.",
      "ordinal": 3,
      "heading_path": [
        "Subject-matter and scope of Part 2",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 4,
      "heading_path": [
        "Subject-matter and scope of Part 2",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Contracts and design contests which are above-threshold, and not subject to any exclusions, must comply with Part 2 PCR.",
      "ordinal": 5,
      "heading_path": [
        "Subject-matter and scope of Part 2",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 6,
      "heading_path": [
        "Subject-matter and scope of Part 2",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 7,
      "heading_path": [
        "Subject-matter and scope of Part 2",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "consider whether the contract to be awarded is above-threshold and / or excluded from Part 2 PCR",
      "ordinal": 8,
      "heading_path": [
        "Subject-matter and scope of Part 2",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "li",
      "text": "consider if measures can or should be taken to protect the UK’s essential security interests.",
      "ordinal": 9,
      "heading_path": [
