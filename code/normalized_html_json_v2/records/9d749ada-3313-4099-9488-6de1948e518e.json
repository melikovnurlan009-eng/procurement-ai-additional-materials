    },
    {
      "block_id": "b00026",
      "block_type": "p",
      "text": "To search for a notice, visit Find a Tender and using the left hand menu:",
      "ordinal": 26,
      "heading_path": [
        "Introducing: UK1 - the Pipeline Notice",
        "For Buyers",
        "For Suppliers"
      ],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00027",
      "block_type": "li",
      "text": "Select ‘UK1 Pipeline notice’ under ‘Notice type’",
      "ordinal": 27,
      "heading_path": [
        "Introducing: UK1 - the Pipeline Notice",
