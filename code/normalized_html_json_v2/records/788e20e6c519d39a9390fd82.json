    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Exempted contracts",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "The guidance documents are intended to provide technical guidance and help with interpretation and understanding of the Procurement Act 2023.",
      "ordinal": 3,
      "heading_path": [
        "Exempted contracts",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "The guidance documents should be read in conjunction with the Procurement Act 2023 and its associated regulations and are aimed at procurement practitioners and commercial policy leads in contracting authorities. They are intended to provide technical guidance and help with interpretation and understanding of the Procurement Act 2023.",
      "ordinal": 4,
      "heading_path": [
        "Exempted contracts",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "An exempted contract is a type of contract to which the rules on covered procurement in the Procurement Act 2023 (Act) do not apply.",
      "ordinal": 5,
      "heading_path": [
        "Exempted contracts",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "The exemptions ensure that contracting authorities have the freedom to carry out the most appropriate procurement where the rules in the Act would otherwise be inappropriate or unsuitable.",
      "ordinal": 6,
      "heading_path": [
        "Exempted contracts",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
