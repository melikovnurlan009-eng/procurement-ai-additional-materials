    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "If you are unable to estimate the value of a contract that contract will be explicitly made subject to the procurement rules.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Thresholds from 1 January 2026",
      "ordinal": 2,
      "heading_path": [
        "Thresholds from 1 January 2026"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "Threshold values were updated and are relevant to procurement exercises which commence on, or after, 1 January 2026.",
      "ordinal": 3,
      "heading_path": [
        "Thresholds from 1 January 2026"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "Scottish Ministers must revise the threshold values of the procurement regulations every two years to ensure that they remain aligned to thresholds set out in the World Trade Organisation’s (WT0)Government Procurement Agreement (GPA).",
      "ordinal": 4,
      "heading_path": [
        "Thresholds from 1 January 2026"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Please refer to SPPN 4/2025 for further information.",
      "ordinal": 5,
      "heading_path": [
        "Thresholds from 1 January 2026"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "The obligations for the calculation and treatment of VAT when considering threshold values remain in place and SPPN08/2021 provides detail on this.",
      "ordinal": 6,
      "heading_path": [
        "Thresholds from 1 January 2026"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "More information can be found at Procurement Threshold and Contract Value Estimation and in Frequently Asked Questions .",
      "ordinal": 7,
      "heading_path": [
        "Thresholds from 1 January 2026"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "WTO GPA procurement thresholds change every 2 years i.e. the most recent threshold change occurred on 1 January 2026, to allow for currency fluctuations.",
      "ordinal": 8,
      "heading_path": [
        "Thresholds from 1 January 2026"
      ],
      "source_locator": null,
      "metadata": {}
    }
  ],
