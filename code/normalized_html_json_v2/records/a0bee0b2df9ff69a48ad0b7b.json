        "Government security classifications policy",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "li",
      "text": "Regulation 53: Electronic availability of procurement documents",
      "ordinal": 17,
      "heading_path": [
