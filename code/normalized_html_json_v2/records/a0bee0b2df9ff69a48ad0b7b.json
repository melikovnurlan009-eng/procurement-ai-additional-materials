      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 19,
      "heading_path": [
        "Government security classifications policy",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00020",
      "block_type": "li",
      "text": "read the PPN and any supporting implementation guidance",
      "ordinal": 20,
      "heading_path": [
        "Government security classifications policy",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
