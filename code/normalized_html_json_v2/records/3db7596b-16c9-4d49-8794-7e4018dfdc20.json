  "title": "Procurement policy note 02/16: Utilities Contracts Regulations 2016 and Concession Contracts Regulations 2016",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0216-utilities-contracts-regulations-2016-and-concession-contracts-regulations-2016",
  "description": "This note explains that these regulations have been laid in Parliament and when they are due to come into force.",
  "publication_date": "2016-03-18T16:15:00+00:00",
  "updated_date": "2016-03-18T16:15:00+00:00",
  "source_metadata": {
