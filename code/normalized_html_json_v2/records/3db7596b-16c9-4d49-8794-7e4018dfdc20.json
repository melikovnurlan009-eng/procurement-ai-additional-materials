  "logical_structure": [],
  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "The Utilities Contracts Regulations 2016 implement the 2014 EU Procurement Directive on Utilities Contracts. The Concession Contracts Regulations 2016 implement the 2014 EU Procurement Directive on Concession Contracts.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "The new procurement rules for concession contracts apply to the public sector and to utilities. The new rules for utilities apply only to contracts let by certain utilities.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "These regulations are due to come into force on 18 April 2016. The new rules apply to procurements starting on or after this date.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "Read further guidance on implementing the EU procurement directives .",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
