  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note ( PPN ) is now out of date.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "Following the UK’s exit from the EU, during the time-limited implementation period, EU law will continue to apply in the UK subject to the terms set out in the Withdrawal Agreement.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "This PPN is issued to outline and seek views on the UK Government’s proposed approach to implementing EU Directive 2014/55/EU on electronic invoicing in public procurement.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
