  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Assisting with procurement investigations",
      "ordinal": 0,
      "heading_path": [
        "Assisting with procurement investigations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Plan > Strategy and plan",
      "ordinal": 1,
      "heading_path": [
        "Assisting with procurement investigations"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Assisting with procurement investigations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This PPN applies to all contracting authorities covered by Section 40 of the Small Business Enterprise and Employment Act 2015 (the SBEE Act). This includes contracting authorities as defined by the Public Contracts Regulations 2015 (PCR 2015), but with some specific exceptions. Exceptions include:",
      "ordinal": 3,
      "heading_path": [
        "Assisting with procurement investigations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "bodies exercising functions that are wholly or mainly devolved, namely Northern Irish, Scottish or Welsh devolved functions",
      "ordinal": 4,
      "heading_path": [
        "Assisting with procurement investigations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "schools and academies, and",
      "ordinal": 5,
      "heading_path": [
        "Assisting with procurement investigations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "procurement of Healthcare Services for the purpose of the NHS.",
      "ordinal": 6,
      "heading_path": [
        "Assisting with procurement investigations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "p",
      "text": "The SBEE Act introduced a strengthened Mystery Shopper service, providing a statutory basis for its procurement investigations. Section 40 of the Act also requires contracting authorities to comply with procurement investigations and assist in investigations by providing relevant information and / or documents within 30 days of receiving a formal notice.",
      "ordinal": 7,
      "heading_path": [
        "Assisting with procurement investigations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "The Mystery Shopper Service investigates and addresses concerns raised about public sector procurements and can also undertake proactive investigations - ‘spot checks’ - of procurement processes and documentation.",
      "ordinal": 8,
      "heading_path": [
        "Assisting with procurement investigations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "p",
      "text": "The Mystery Shopper Service changed its name to the Public Procurement Review Service (PPRS) in November 2018.",
      "ordinal": 9,
      "heading_path": [
        "Assisting with procurement investigations",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 10,
      "heading_path": [
        "Assisting with procurement investigations",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "p",
      "text": "The Mystery Shopper Service (now referred to as PPRS) may require contracting authorities to provide relevant information and / or documents within 30 days of a formal notice requiring them.",
      "ordinal": 11,
      "heading_path": [
        "Assisting with procurement investigations",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 12,
      "heading_path": [
        "Assisting with procurement investigations",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 13,
      "heading_path": [
        "Assisting with procurement investigations",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "li",
      "text": "provide assistance in connection with procurement investigations conducted as part of the Mystery Shopper service (now referred to as PPRS), including any requests for relevant information and / or documents within 30 days of a formal request",
      "ordinal": 14,
      "heading_path": [
        "Assisting with procurement investigations",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "li",
      "text": "ensure that public procurements do not impose unnecessary barriers to small businesses when bidding for public contracts.",
      "ordinal": 15,
      "heading_path": [
        "Assisting with procurement investigations",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 16,
      "heading_path": [
        "Assisting with procurement investigations",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "p",
      "text": "This PPN should be read alongside the relevant parts of the legal framework but it is not designed to provide guidance on a particular clause or regulation from the PCR 2015.",
      "ordinal": 17,
      "heading_path": [
        "Assisting with procurement investigations",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "heading",
      "text": "Additional support and guidance",
      "ordinal": 18,
      "heading_path": [
        "Assisting with procurement investigations",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 19,
      "heading_path": [
        "Assisting with procurement investigations",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00020",
      "block_type": "li",
      "text": "read the PPN and any supporting implementation guidance",
      "ordinal": 20,
      "heading_path": [
        "Assisting with procurement investigations",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00021",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 21,
      "heading_path": [
        "Assisting with procurement investigations",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
