  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "heading",
      "text": "Selection criteria",
      "ordinal": 0,
      "heading_path": [
        "Selection criteria"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Procure > Finalise and publish procurement pack",
      "ordinal": 1,
      "heading_path": [
        "Selection criteria"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation sets out rules which the contracting authority may use to impose minimum requirements on candidates to participate in a procurement procedure. The regulation also provides further rules relating to the permitted categories of selection criteria, namely they may only relate to:",
      "ordinal": 3,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "(a) suitability to pursue a professional activity",
      "ordinal": 4,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "(b) economic and financial standing, and",
      "ordinal": 5,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "p",
      "text": "(c) technical and professional ability.",
      "ordinal": 6,
      "heading_path": [
        "Selection criteria",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 7,
      "heading_path": [
        "Selection criteria",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "p",
      "text": "A contracting authority may impose selection criteria in order to limit the number of candidates invited to participate in the procurement process.",
      "ordinal": 8,
      "heading_path": [
        "Selection criteria",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 9,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 10,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "li",
      "text": "ensure that its selection criteria are sufficiently developed by the time it advertises the procurement opportunity to the market and, ensure that all selection criteria comply with the relevant conditions set out in this regulation (i.e. regulation 58)",
      "ordinal": 11,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "li",
      "text": "consider whether to shortlist the number of candidates invited to participate in the procurement by reference to their: (a) suitability and professional qualifications; (b) economic and financial standing, and; (c) technical and professional ability",
      "ordinal": 12,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "consider whether to use a standard selection questionnaire (SQ) and whether this needs to be tailored to the details of the specific contract opportunity",
      "ordinal": 13,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "li",
      "text": "publish the requirements for participation at the commencement of the procurement process, ensuring that these requirements are clearly set out in the contract notice and procurement documents.",
      "ordinal": 14,
      "heading_path": [
        "Selection criteria",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 15,
      "heading_path": [
        "Selection criteria",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00016",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 16,
      "heading_path": [
        "Selection criteria",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00017",
      "block_type": "li",
      "text": "Section 22: Conditions of Participation",
      "ordinal": 17,
      "heading_path": [
        "Selection criteria",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "heading",
      "text": "Additional support and guidance",
      "ordinal": 18,
      "heading_path": [
        "Selection criteria",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 19,
      "heading_path": [
        "Selection criteria",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00020",
      "block_type": "li",
      "text": "read the regulation",
      "ordinal": 20,
      "heading_path": [
        "Selection criteria",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00021",
      "block_type": "li",
      "text": "seek legal and commercial advice in the context of specific procurements",
      "ordinal": 21,
      "heading_path": [
        "Selection criteria",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00022",
      "block_type": "heading",
      "text": "This applies to",
      "ordinal": 22,
      "heading_path": [
        "Selection criteria",
        "Additional support and guidance",
        "This applies to"
      ],
      "source_locator": null,
      "metadata": {}
    },
