  "title": "Procurement Policy Note 04/15: taking account of suppliers’ past performance",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0415-taking-account-of-suppliers-past-performance",
  "description": "This note sets out government policy to ensure suppliers' past performance is taken into account.",
  "publication_date": "2015-03-25T15:09:00+00:00",
  "updated_date": "2015-03-25T15:09:00+00:00",
  "source_metadata": {
    "content_id": "c2f091ac-d353-4339-84c4-935dc2f9a412",
