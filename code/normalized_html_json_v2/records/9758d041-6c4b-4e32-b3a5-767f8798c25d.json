  "title": "Procurement policy note 03/16: publication of payment performance statistics",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0316-publication-of-payment-performance-statistics",
  "description": "This note explains how public sector contracting authorities are to start publishing annual payment performance data after March 2016.",
  "publication_date": "2016-03-29T20:04:00+01:00",
