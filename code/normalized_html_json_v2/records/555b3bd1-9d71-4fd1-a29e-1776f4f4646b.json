  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note ( PPN ) sets out how contracting authorities can further cut ties with companies backed by the states of Russia and Belarus.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "It applies to:",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "li",
      "text": "all central government departments",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "li",
      "text": "their executive agencies",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "non-departmental public bodies",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "p",
      "text": "Other public sector contracting authorise should consider applying the approach set out in this PPN .",
      "ordinal": 5,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
