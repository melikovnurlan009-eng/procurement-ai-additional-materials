  "title": "Procurement Policy Note 04/21: Applying Exclusions in Public Procurement, Managing Conflicts of Interest and Whistleblowing",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0421-applying-exclusions-in-public-procurement-managing-conflicts-of-interest-and-whistleblowing",
  "description": "Reminds In-scope Organisations of their obligations in applying exclusions and preventing, identifying and remedying conflicts of interest in public procurement.",
  "publication_date": "2021-05-20T14:00:00+01:00",
  "updated_date": "2021-09-09T10:47:51+01:00",
  "source_metadata": {
    "content_id": "afc54853-2269-482e-9589-1f2b4ab1ffaf",
    "base_path": "/government/publications/procurement-policy-note-0421-applying-exclusions-in-public-procurement-managing-conflicts-of-interest-and-whistleblowing",
    "document_type": "guidance",
    "schema_name": "publication",
    "publishing_app": "whitehall",
    "rendering_app": "frontend",
