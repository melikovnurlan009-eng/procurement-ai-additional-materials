    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "In: Plan > Strategy and plan",
      "ordinal": 1,
      "heading_path": [
        "Defence and Security"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "heading",
      "text": "Overview",
      "ordinal": 2,
      "heading_path": [
        "Defence and Security",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that Part 2 PCR 2015 does not apply to public contracts:",
      "ordinal": 3,
      "heading_path": [
        "Defence and Security",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "li",
      "text": "that fall within the scope of the Defence and Security Public Contracts Regulations 2011",
      "ordinal": 4,
      "heading_path": [
        "Defence and Security",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00005",
      "block_type": "li",
      "text": "to which the Defence and Security Public Contracts Regulations 2011 do not apply by virtue of regulations 7 and 9 of those regulations",
      "ordinal": 5,
      "heading_path": [
        "Defence and Security",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00006",
      "block_type": "li",
      "text": "where the application of Part 2 PCR 2015 would oblige the UK to supply information that could impact on national security",
      "ordinal": 6,
      "heading_path": [
        "Defence and Security",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00007",
      "block_type": "li",
      "text": "where the protection of the essential security interests of the UK cannot be guaranteed by less intrusive measures, and",
      "ordinal": 7,
      "heading_path": [
        "Defence and Security",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00008",
      "block_type": "li",
      "text": "where the procurement and performance of the public contract is legally classified as secret or required to be accompanied by special security measures (assuming that the essential interests concerned cannot be guaranteed by less intrusive measures).",
      "ordinal": 8,
      "heading_path": [
        "Defence and Security",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00009",
      "block_type": "heading",
      "text": "Objective at this commercial stage",
      "ordinal": 9,
      "heading_path": [
        "Defence and Security",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00010",
      "block_type": "p",
      "text": "Part 2 PCR will not apply to any contracts referred to in this regulation (i.e. regulation 15).",
      "ordinal": 10,
      "heading_path": [
        "Defence and Security",
        "Objective at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00011",
      "block_type": "heading",
      "text": "Key considerations at this commercial stage",
      "ordinal": 11,
      "heading_path": [
        "Defence and Security",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00012",
      "block_type": "p",
      "text": "Contracting authorities should:",
      "ordinal": 12,
      "heading_path": [
        "Defence and Security",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00013",
      "block_type": "li",
      "text": "ensure the subject-matter and circumstances of any public contract are reviewed and consideration is given as to whether this regulation (i.e. regulation 15) will apply.",
      "ordinal": 13,
      "heading_path": [
        "Defence and Security",
        "Key considerations at this commercial stage"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00014",
      "block_type": "heading",
      "text": "Legal framework",
      "ordinal": 14,
      "heading_path": [
        "Defence and Security",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00015",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 15,
