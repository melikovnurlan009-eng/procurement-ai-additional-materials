  "logical_structure": [],
  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This Procurement Policy Note (PPN) is now out of date. Please refer to PPN 14/15: Supporting Apprenticeships and Skills through Public Procurement",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "Government requires public procurers of major construction and infrastructure projects, with a capital value over £50 million, to use public procurement to increase investment in training and apprenticeships.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "Procurement decisions should always be made on a quality, cost and risk basis. However decisions can take into account qualitative long-term benefits on the supply side, eg appropriate investment in skills development, as long as they are consistent with the government’s overarching priority of value for money.",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This policy aims to support growth by building a more skilled and productive workforce, reducing the risks of supply constraints and increased labour cost inflation.",
      "ordinal": 3,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "This note has been replaced by Policy Procurement Note 14/15 on supporting apprenticeships and skills through public procurement .",
      "ordinal": 4,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
  ],
