  "title": "Procurement Policy Note 06/15: sustainable skills development through major projects",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0615-sustainable-skills-development-through-major-projects",
  "description": "This Procurement Policy Note (PPN) [and guidance / documents] is now out of date",
  "publication_date": "2015-03-27T18:44:00+00:00",
