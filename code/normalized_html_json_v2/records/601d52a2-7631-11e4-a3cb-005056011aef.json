  "title": "Procurement Policy Note 09/14: Cyber Essentials scheme certification",
  "canonical_url": "https://www.gov.uk/government/publications/procurement-policy-note-0914-cyber-essentials-scheme-certification",
  "description": "This note explains how to use the Cyber Essentials scheme, which aims to reduce cyber security risk in government supply chains.",
  "publication_date": "2014-09-26T10:14:00+01:00",
  "updated_date": "2016-05-26T16:39:44+01:00",
  "source_metadata": {
    "content_id": "601d52a2-7631-11e4-a3cb-005056011aef",
