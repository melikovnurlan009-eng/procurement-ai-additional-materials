  "content_blocks": [
    {
      "block_id": "b00000",
      "block_type": "p",
      "text": "This note has been replaced by procurement policy note 01/17: update to transparency principles.",
      "ordinal": 0,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00001",
      "block_type": "p",
      "text": "This procurement policy note provides guidance on the how to implement the transparency principles published in March 2015. It aims to increase the type and accessibility of contract and procurement data to the public.",
      "ordinal": 1,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    },
    {
      "block_id": "b00002",
      "block_type": "p",
      "text": "It applies to all central government departments including their executive agencies and non-departmental public bodies (NDPBs).",
      "ordinal": 2,
      "heading_path": [],
      "source_locator": "details.body",
      "metadata": {}
    }
