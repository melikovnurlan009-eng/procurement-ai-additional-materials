    {
      "block_id": "b00003",
      "block_type": "p",
      "text": "This regulation provides that public contracts for social and certain specific services should be awarded in accordance with section 7 (social and other specific services) of the PCR 2015 (otherwise known as the ‘Light Touch Regime’).",
      "ordinal": 3,
      "heading_path": [
        "Award of contracts for social and other specific services",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00004",
      "block_type": "p",
      "text": "The specific services referred to in this regulation (i.e. regulation 74) are contained in schedule 3 (social and other specific services) of the PCR 2015 and include certain:",
      "ordinal": 4,
      "heading_path": [
        "Award of contracts for social and other specific services",
        "Overview"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
