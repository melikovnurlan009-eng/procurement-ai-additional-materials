      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00018",
      "block_type": "p",
      "text": "See also in the Procurement Act 2023:",
      "ordinal": 18,
      "heading_path": [
        "Labels",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00019",
      "block_type": "li",
      "text": "Section 23: Award criteria",
      "ordinal": 19,
      "heading_path": [
        "Labels",
        "Legal framework"
      ],
      "source_locator": null,
      "metadata": {}
    },
