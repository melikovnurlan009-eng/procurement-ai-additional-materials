      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00021",
      "block_type": "p",
      "text": "Make sure you:",
      "ordinal": 21,
      "heading_path": [
        "Labels",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
      "block_id": "b00022",
      "block_type": "li",
      "text": "read the regulation",
      "ordinal": 22,
      "heading_path": [
        "Labels",
        "Additional support and guidance"
      ],
      "source_locator": null,
      "metadata": {}
    },
    {
