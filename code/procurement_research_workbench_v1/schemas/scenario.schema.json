{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public retrieval scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "scenario_group_id",
    "split",
    "suite",
    "topic",
    "as_of",
    "user_message",
    "history",
    "synthetic"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "scenario_group_id": {
      "type": "string"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ]
    },
    "suite": {
      "enum": [
        "statutory",
        "semantic",
        "vocabulary",
        "multi_evidence",
        "applicability",
        "guidance",
        "authority",
        "compound",
        "followup"
      ]
    },
    "topic": {
      "type": "string"
    },
    "as_of": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "user_message": {
      "type": "string",
      "minLength": 20
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "synthetic": {
      "const": true
    },
    "authoring_status": {
      "type": "string"
    },
    "history_protocol": {
      "type": "string"
    },
    "parent_scenario_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
